{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "file:///C:/Users/inilu/.local/share/opencode/packages/unica-opencode/installs/0.12.0-win-x64-9af2bd7856ce/node_modules/@apshendev/unica-opencode",
  ],
  "mcp": {
    "1c-platform-help": {
      "type": "remote",
      "url": "http://localhost:8992/mcp",
      "headers": {
        "x-platform-version": "8.3.27.2214",
      },
    },
    "1c-bsl-language-server": {
      "type": "remote",
      "url": "http://localhost:8980/mcp",
    },
    "1c-v8std-local": {
      "type": "remote",
      "url": "http://localhost:8960/mcp",
    },
    "1c-testclient-ib": {
      "enabled": false,
      "type": "remote",
      "url": "http://localhost:9874/mcp",
    },
  },
  "agent": {
    "plan": {
      "permission": {
        "read": "allow",
        "skill": "allow",
        "bash": {
          "git status *": "allow",
          "gh issue view *": "allow",
        },
      },
    },
    "build": {
      "model": "zai-coding-plan/glm-5.3",
      "reasoningEffort": "max",
      "permission": {
        "edit": "allow",
        "read": "allow",
        "skill": "allow",
        "bash": {
          "*": "ask",
          "git *": "allow",
          "gh issue *": "allow",
          "uv *": "allow",
        },
      },
    },
    "explore": {
      "model": "zai-coding-plan/glm-5.3-Flash",
      "reasoningEffort": "high",
    },
    "review-agent": {
      "model": "zai-coding-plan/glm-5.3",
      "reasoningEffort": "max",
    },
  },
}