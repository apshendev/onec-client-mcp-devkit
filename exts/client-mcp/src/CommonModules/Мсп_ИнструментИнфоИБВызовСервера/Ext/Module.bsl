#Область СлужебныйПрограммныйИнтерфейс

// Возвращает сведения о конфигурации, встроенном языке и расширениях информационной базы.
//
// Возвращаемое значение:
//  Структура - Сведения:
//   * Конфигурация - Структура - Имя и Версия основной конфигурации.
//   * ВстроенныйЯзык - Строка - "ru" или "en".
//   * Расширения - Массив из Структура - Описания подключенных расширений.
//   * РасширенияДоступны - Булево - Ложь, если список расширений получить не удалось (например, нет прав).
Функция СведенияКонфигурации() Экспорт
	Сведения = Новый Структура;
	Сведения.Вставить("Конфигурация", НовыйОписаниеКонфигурации(
		Метаданные.Представление(),
		Метаданные.Версия));
	Сведения.Вставить("ВстроенныйЯзык", ВстроенныйЯзык());

	Расширения = ПолучитьРасширенияКонфигурации();
	Сведения.Вставить("Расширения", Расширения.Список);
	Сведения.Вставить("РасширенияДоступны", Расширения.Доступны);

	Возврат Сведения;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйОписаниеКонфигурации(Имя, Версия)
	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Версия", Версия);
	Возврат Описание;
КонецФункции

Функция ВстроенныйЯзык()
	ЭтоРусскийВстроенныйЯзык = Метаданные.ВариантВстроенногоЯзыка = Метаданные.СвойстваОбъектов.ВариантВстроенногоЯзыка.Русский;
	Возврат Формат(ЭтоРусскийВстроенныйЯзык, "БЛ=en; БИ=ru;");
КонецФункции

Функция ПолучитьРасширенияКонфигурации()
	Результат = Новый Структура;
	Результат.Вставить("Доступны", Истина);
	Результат.Вставить("Список", Новый Массив);

	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Результат.Список.Добавить(НовыйОписаниеРасширения(Расширение));
		КонецЦикла;
	Исключение
		// Нет прав на чтение расширений или безопасный режим.
		Результат.Доступны = Ложь;
		Результат.Список.Очистить();
	КонецПопытки;

	Возврат Результат;
КонецФункции

Функция НовыйОписаниеРасширения(Расширение)
	Описание = Новый Структура;
	Описание.Вставить("Имя", Расширение.Имя);
	Описание.Вставить("Версия", Расширение.Версия);
	Описание.Вставить("БезопасныйРежим", Расширение.БезопасныйРежим);
	Описание.Вставить("ЗащитаОтОпасныхДействий",
		Строка(Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях));
	Возврат Описание;
КонецФункции

#КонецОбласти
