#Область ПрограммныйИнтерфейс

// Выполняет запрос 1С только на чтение. Источник переноса - ЗапросPOST модуля
// MCPService mcp-1c; семантика безопасности сохранена: текст обязан начинаться с
// ВЫБРАТЬ или SELECT, и в тексте запрещена лексема ПОМЕСТИТЬ (создание временных
// таблиц) - это единственный вид записи данных, проходящий префиксную проверку.
// УДАЛИТЬ и ИЗМЕНИТЬ префиксную проверку не проходят.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса;
//  Лимит - Число, Неопределено - максимум возвращаемых строк; по умолчанию 100,
//   потолок 1000; значение 0 или меньше означает лимит по умолчанию; значение
//   нечислового типа отклоняется;
//  ПараметрыЗапроса - Структура, Неопределено - значения параметров запроса; строковые
//   значения в формате ISO 8601 автоматически приводятся к типу Дата.
//
// Возвращаемое значение:
//  Структура - Поля 1:1 к ответу /query mcp-1c:
//   * columns - Массив из Строка - имена колонок;
//   * rows - Массив из Массив - значения строк, приведённые к JSON-совместимому виду;
//   * total - Число - количество возвращённых строк;
//   * truncated - Булево - признак усечения выдачи по лимиту.
//
// Вызывает исключение:
//  При пустом тексте запроса, нечисловом лимите, нарушении правила SELECT-only
//  или ошибке выполнения запроса (с текстом платформы).
Функция ВыполнитьЗапрос(Знач ТекстЗапроса, Знач Лимит = Неопределено, Знач ПараметрыЗапроса = Неопределено) Экспорт

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ВызватьИсключение "query is required";
	КонецЕсли;

	Если Лимит <> Неопределено И ЗначениеЗаполнено(Лимит) Тогда
		Если ТипЗнч(Лимит) <> Тип("Число") Тогда
			ВызватьИсключение "limit must be a number";
		КонецЕсли;
		Если Лимит > 0 Тогда
			Лимит = Мин(Лимит, 1000);
		Иначе
			Лимит = 100;
		КонецЕсли;
	Иначе
		Лимит = 100;
	КонецЕсли;

	Префикс = ВРег(СокрЛП(Лев(ТекстЗапроса, 10)));
	Если Лев(Префикс, 7) <> "ВЫБРАТЬ" И Лев(Префикс, 6) <> "SELECT" Тогда
		ВызватьИсключение "Only SELECT queries allowed";
	КонецЕсли;

	// Запрет ВЫБРАТЬ-вставок: ПОМЕСТИТЬ (русская лексема) и INTO (английская) создают
	// временные таблицы и проходят префиксную проверку, поэтому проверяются явно.
	Если СодержитЛексему(ТекстЗапроса, "ПОМЕСТИТЬ") ИЛИ СодержитЛексему(ТекстЗапроса, "INTO") Тогда
		ВызватьИсключение "Only SELECT queries allowed";
	КонецЕсли;

	Попытка
		Запрос1С = Новый Запрос(ТекстЗапроса);

		Если ТипЗнч(ПараметрыЗапроса) = Тип("Структура") Тогда
			Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
				Запрос1С.УстановитьПараметр(КлючИЗначение.Ключ,
					ПреобразоватьЗначениеПараметра(КлючИЗначение.Значение));
			КонецЦикла;
		КонецЕсли;

		РезультатЗапроса = Запрос1С.Выполнить();
	Исключение
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;

	Выборка = РезультатЗапроса.Выбрать();

	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Счетчик = 0;
	Усечено = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Счетчик >= Лимит Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;
		Строка = Новый Массив;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Строка.Добавить(ПривестиЗначениеКJSON(Выборка[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(Строка);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("total", Счетчик);
	Результат.Вставить("truncated", Усечено);

	Возврат Результат;

КонецФункции

// Проверяет синтаксис запроса без выполнения. Источник переноса - ПроверкаЗапросаPOST
// модуля MCPService mcp-1c.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса.
//
// Возвращаемое значение:
//  Структура:
//   * valid - Булево - признак успешного разбора текста схемой запроса;
//   * errors - Массив из Строка - тексты ошибок (пустой при valid = Истина).
//
// Вызывает исключение:
//  При пустом тексте запроса ("query is required").
Функция ПроверитьЗапрос(Знач ТекстЗапроса) Экспорт

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ВызватьИсключение "query is required";
	КонецЕсли;

	Ошибки = Новый Массив;

	Попытка
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
		СхемаЗапроса.ПолучитьТекстЗапроса();

		Результат = Новый Структура;
		Результат.Вставить("valid", Истина);
		Результат.Вставить("errors", Ошибки);
	Исключение
		Результат = Новый Структура;
		Результат.Вставить("valid", Ложь);
		Ошибки.Добавить(ОписаниеОшибки());
		Результат.Вставить("errors", Ошибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значения параметров запроса приходят из JSON строками. Если строка имеет ISO-формат
// даты ("ГГГГ-ММ-ДД" или "ГГГГ-ММ-ДДTчч:мм:сс"), приводим её к типу Дата - иначе
// виртуальные таблицы (Остатки(&Дата, ...)) дают "Несоответствие типов". Нестроковые
// значения и строки иного вида возвращаются без изменений; при неудаче разбора
// возвращается исходная строка (безопасный откат к прежнему поведению).
Функция ПреобразоватьЗначениеПараметра(Знач Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Длина = СтрДлина(Значение);
	РазделителиДаты = (Сред(Значение, 5, 1) = "-") И (Сред(Значение, 8, 1) = "-");
	ЭтоДата = (Длина = 10) И РазделителиДаты;
	ЭтоДатаВремя = (Длина >= 19) И РазделителиДаты
		И (Сред(Значение, 11, 1) = "T" ИЛИ Сред(Значение, 11, 1) = " ")
		И (Сред(Значение, 14, 1) = ":") И (Сред(Значение, 17, 1) = ":");

	Если НЕ (ЭтоДата ИЛИ ЭтоДатаВремя) Тогда
		Возврат Значение;
	КонецЕсли;

	Если ЭтоДата Тогда
		СтрокаДаты = Значение + "T00:00:00";
	Иначе
		СтрокаДаты = СтрЗаменить(Лев(Значение, 19), " ", "T");
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), СтрокаДаты);
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

// Приводит значение ячейки выборки к JSON-совместимому виду: Неопределено и NULL -
// к пустой строке, Число и Булево остаются как есть, прочее - к Строка.
Функция ПривестиЗначениеКJSON(Значение)

	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	Иначе
		Возврат Строка(Значение);
	КонецЕсли;

КонецФункции

// Проверяет, что в тексте запроса встречается ключевое слово как отдельная лексема
// (окружённая пробелами или границами строки), чтобы не задеть идентификаторы вида
// "МояПОМЕСТИТЬФункция". Поиск по верхнему регистру.
Функция СодержитЛексему(Текст, Слово)

	ИскомоеСлово = " " + ВРег(Слово) + " ";

	Для ИндексСтроки = 1 По СтрЧислоСтрок(Текст) Цикл
		Строка = СтрЗаменить(СтрПолучитьСтроку(Текст, ИндексСтроки), Символы.Таб, " ");
		НормализованнаяСтрока = " " + ВРег(СокрЛП(Строка)) + " ";
		Если СтрНайти(НормализованнаяСтрока, ИскомоеСлово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
