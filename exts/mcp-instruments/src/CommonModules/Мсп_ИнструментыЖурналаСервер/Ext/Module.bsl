#Область ПрограммныйИнтерфейс

// Выгружает события журнала регистрации с отборами. Источник переноса - ЖурналРегистрацииPOST
// модуля MCPService mcp-1c.
//
// ПРАВО ПРОВЕРЯЕТСЯ ДО ВСЕГО ОСТАЛЬНОГО. Без права Администрирование
// ВыгрузитьЖурналРегистрации не возвращает ничего: оно бросает исключение. Это проверка,
// а не Попытка, и разница несущая: обёртка вокруг выгрузки сделала бы неверным утверждение,
// что отказ не несёт ни одной записи и ни их количества. Частичный или неотфильтрованный
// журнал под видом обычного ответа хуже отказа. ВыгрузитьЖурналРегистрация стоит ВНЕ
// любого Попытка - исключение из неё покидает функцию как есть.
//
// Параметры:
//  ПараметрыОтбора - Структура, Неопределено - отборы; допустимые ключи:
//   * start_date - Строка - дата начала в формате ISO 8601;
//   * end_date - Строка - дата окончания в формате ISO 8601;
//   * level - Строка - уровень (Ошибка, Предупреждение, Информация, Примечание);
//   * user - Строка - имя пользователя информационной базы;
//   * limit - Число - потолок выдачи (по умолчанию 50, максимум 500).
//   Отбор, который применить нельзя, ОТКЛОНЯЕТСЯ, а не отбрасывается: молча отброшенный
//   отбор неотличим от ответа на запрос вообще без отбора. Если дата начала не задана,
//   выгружаются последние 7 дней (защита от исчерпания памяти).
//
// Возвращаемое значение:
//  Структура:
//   * events - Массив из Структура - события {date, level, event, user, computer,
//     metadata, data, comment, transaction};
//   * total - Число - общее число записей, подошедших под отбор.
//
// Вызывает исключение:
//  Если нет права Администрирование, либо значение отбора невозможно применить
//  (неверный формат даты, неизвестный уровень, неизвестный пользователь, нечисловой
//  лимит) - с текстами исходных ошибок валидации mcp-1c.
Функция СобытияЖурнала(Знач ПараметрыОтбора = Неопределено) Экспорт

	// Отказ не несёт ни одной записи и не несёт их количества.
	Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение "reading the event log requires the Администрирование right "
			+ "and this account does not have it; no records are returned";
	КонецЕсли;

	Если ПараметрыОтбора = Неопределено Тогда
		Параметры = Новый Структура;
	Иначе
		Если ТипЗнч(ПараметрыОтбора) <> Тип("Структура") Тогда
			ВызватьИсключение "arguments must be a JSON object";
		КонецЕсли;
		Параметры = ПараметрыОтбора;
	КонецЕсли;

	Отбор = Новый Структура;

	Если Параметры.Свойство("start_date") И ЗначениеЗаполнено(Параметры.start_date) Тогда
		ДатаНачала = Неопределено;
		Попытка
			ДатаНачала = XMLЗначение(Тип("Дата"), Параметры.start_date);
		Исключение
		КонецПопытки;
		Если ДатаНачала = Неопределено Тогда
			ВызватьИсключение "start_date is not an ISO 8601 date (e.g. 2026-03-01T00:00:00): "
				+ Строка(Параметры.start_date);
		КонецЕсли;
		Отбор.Вставить("ДатаНачала", ДатаНачала);
	КонецЕсли;

	Если Параметры.Свойство("end_date") И ЗначениеЗаполнено(Параметры.end_date) Тогда
		ДатаОкончания = Неопределено;
		Попытка
			ДатаОкончания = XMLЗначение(Тип("Дата"), Параметры.end_date);
		Исключение
		КонецПопытки;
		Если ДатаОкончания = Неопределено Тогда
			ВызватьИсключение "end_date is not an ISO 8601 date (e.g. 2026-03-07T23:59:59): "
				+ Строка(Параметры.end_date);
		КонецЕсли;
		Отбор.Вставить("ДатаОкончания", ДатаОкончания);
	КонецЕсли;

	Если Параметры.Свойство("level") И ЗначениеЗаполнено(Параметры.level) Тогда
		СоответствиеУровней = Новый Соответствие;
		СоответствиеУровней.Вставить("Ошибка", УровеньЖурналаРегистрации.Ошибка);
		СоответствиеУровней.Вставить("Предупреждение", УровеньЖурналаРегистрации.Предупреждение);
		СоответствиеУровней.Вставить("Информация", УровеньЖурналаРегистрации.Информация);
		СоответствиеУровней.Вставить("Примечание", УровеньЖурналаРегистрации.Примечание);
		Уровень = СоответствиеУровней[Параметры.level];
		Если Уровень = Неопределено Тогда
			ВызватьИсключение "unknown level: " + Строка(Параметры.level)
				+ " (allowed: Ошибка, Предупреждение, Информация, Примечание)";
		КонецЕсли;
		МассивУровней = Новый Массив;
		МассивУровней.Добавить(Уровень);
		Отбор.Вставить("Уровень", МассивУровней);
	КонецЕсли;

	// У отбора по пользователю ДВА разных отказа. Имени нет в списке пользователей ИБ:
	// значение выбрал вызывающий и он может его исправить - это ошибка значения. Сам поиск
	// не состоялся: правкой значения тут ничего не решить - это ошибка доступа. Это разные
	// причины, и звать они должны в разные места. Причину здесь не называем: до сюда
	// доходит только тот, у кого право Администрирование есть.
	Если Параметры.Свойство("user") И ЗначениеЗаполнено(Параметры.user) Тогда
		Если ТипЗнч(Параметры.user) <> Тип("Строка") Тогда
			ВызватьИсключение "user must be a string";
		КонецЕсли;
		ПользовательИБ = Неопределено;
		ОшибкаПоиска = "";
		Попытка
			ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Параметры.user);
		Исключение
			ОшибкаПоиска = ОписаниеОшибки();
		КонецПопытки;
		Если ЗначениеЗаполнено(ОшибкаПоиска) Тогда
			ВызватьИсключение "user filter cannot be resolved: " + ОшибкаПоиска;
		КонецЕсли;
		Если ПользовательИБ = Неопределено Тогда
			ВызватьИсключение "unknown infobase user: " + Параметры.user;
		КонецЕсли;
		МассивПользователей = Новый Массив;
		МассивПользователей.Добавить(ПользовательИБ);
		Отбор.Вставить("Пользователь", МассивПользователей);
	КонецЕсли;

	// Лимит - это потолок выдачи, а не отбор: 0 и отрицательное значение означают
	// "сколько по умолчанию". Нечисловое значение отклоняется, а не роняет функцию.
	Лимит = 50;
	Если Параметры.Свойство("limit") И ЗначениеЗаполнено(Параметры.limit) Тогда
		Если ТипЗнч(Параметры.limit) <> Тип("Число") Тогда
			ВызватьИсключение "limit must be a number";
		КонецЕсли;
		Если Параметры.limit > 0 Тогда
			Лимит = Мин(Параметры.limit, 500);
		КонецЕсли;
	КонецЕсли;

	// Защита от исчерпания памяти: если не указана дата начала, ограничиваем последними
	// 7 днями.
	Если НЕ Отбор.Свойство("ДатаНачала") Тогда
		Отбор.Вставить("ДатаНачала", ТекущаяДата() - 7 * 86400);
	КонецЕсли;

	ТаблицаЖурнала = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Отбор);

	ВсегоЗаписей = ТаблицаЖурнала.Количество();

	МассивСобытий = Новый Массив;
	Для Индекс = 0 По Мин(Лимит, ВсегоЗаписей) - 1 Цикл
		Строка = ТаблицаЖурнала[Индекс];
		Событие = Новый Структура;
		Событие.Вставить("date", XMLСтрока(Строка.Дата));
		Событие.Вставить("level", Строка(Строка.Уровень));
		Событие.Вставить("event", Строка(Строка.Событие));
		Событие.Вставить("user", Строка(Строка.ИмяПользователя));
		Событие.Вставить("computer", Строка(Строка.Компьютер));
		Событие.Вставить("metadata", ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "МетаданныеПредставление"));
		Событие.Вставить("data", ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "ДанныеПредставление"));
		Событие.Вставить("comment", ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "Комментарий"));
		Событие.Вставить("transaction", ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "ИдентификаторТранзакции"));
		МассивСобытий.Добавить(Событие);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("events", МассивСобытий);
	Результат.Вставить("total", ВсегоЗаписей);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значение колонки журнала регистрации; колонки МетаданныеПредставление,
// ДанныеПредставление, Комментарий и ИдентификаторТранзакции могут отсутствовать в
// выгрузке - тогда возвращается пустая строка.
Функция ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, ИмяКолонки)

	Если ТаблицаЖурнала.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Строка[ИмяКолонки]);

КонецФункции

#КонецОбласти
