#Область ПрограммныйИнтерфейс

// Регистрирует инструменты и промпты провайдера журнала регистрации.
Процедура Зарегистрировать(ИсточникРегистрации) Экспорт
	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"get_event_log",
		ОписаниеИнструментаЖурналаРегистрации(),
		СхемаИнструментаЖурналаРегистрации(),
		Новый ОписаниеОповещения("ОбработатьИнструментЖурналаРегистрации", Мсп_ИнструментыЖурналаКлиент)),
		ИсточникРегистрации);

	ЗарегистрироватьПромптАнализаОшибки(ИсточникРегистрации);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает вызов get_event_log.
//
// Параметры:
//  Запрос - Структура - Запрос инструмента:
//   * Аргументы - Структура - Аргументы вызова: start_date, end_date, level, user, limit.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры вызова.
//
// Возвращаемое значение:
//  Структура - Результат вызова инструмента.
Функция ОбработатьИнструментЖурналаРегистрации(Запрос, ДополнительныеПараметры) Экспорт
	Попытка
		ПараметрыОтбора = Новый Структура;

		ДатаНачала = Неопределено;
		Если Запрос.Аргументы.Свойство("start_date", ДатаНачала) И ДатаНачала <> Неопределено Тогда
			ПараметрыОтбора.Вставить("start_date", ДатаНачала);
		КонецЕсли;

		ДатаОкончания = Неопределено;
		Если Запрос.Аргументы.Свойство("end_date", ДатаОкончания) И ДатаОкончания <> Неопределено Тогда
			ПараметрыОтбора.Вставить("end_date", ДатаОкончания);
		КонецЕсли;

		Уровень = Неопределено;
		Если Запрос.Аргументы.Свойство("level", Уровень) И Уровень <> Неопределено Тогда
			ПараметрыОтбора.Вставить("level", Уровень);
		КонецЕсли;

		Пользователь = Неопределено;
		Если Запрос.Аргументы.Свойство("user", Пользователь) И Пользователь <> Неопределено Тогда
			ПараметрыОтбора.Вставить("user", Пользователь);
		КонецЕсли;

		Лимит = Неопределено;
		Если Запрос.Аргументы.Свойство("limit", Лимит) И Лимит <> Неопределено Тогда
			Если ТипЗнч(Лимит) <> Тип("Число") Тогда
				Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS", "limit must be a number");
			КонецЕсли;
			ПараметрыОтбора.Вставить("limit", Лимит);
		КонецЕсли;

		Возврат Мсп_Результаты.JSON(Мсп_ИнструментыЖурналаСервер.СобытияЖурнала(ПараметрыОтбора));
	Исключение
		Возврат ОшибкаСервера(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Регистрирует промпт analyze_error.
//
// Параметры:
//  ИсточникРегистрации - Произвольный - Источник регистрации провайдера.
Процедура ЗарегистрироватьПромптАнализаОшибки(ИсточникРегистрации)
	Аргументы = Новый Массив;
	Аргументы.Добавить(Новый Структура("name,description,required",
		"error_text", "Текст ошибки из 1С", Истина));

	Мсп_Сервер.ЗарегистрироватьПромпт(Мсп_Сервер.НовыйПромпт(
		"analyze_error",
		"Анализ ошибки 1С",
		Аргументы,
		Новый ОписаниеОповещения("ОбработатьПромптАнализаОшибки", Мсп_ИнструментыЖурналаКлиент)),
		ИсточникРегистрации);
КонецПроцедуры

// Обрабатывает вызов промпта analyze_error.
//
// Параметры:
//  Запрос - Структура - Запрос промпта:
//   * Аргументы - Структура - Аргументы вызова: error_text.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры вызова.
//
// Возвращаемое значение:
//  Структура - Результат вызова промпта.
Функция ОбработатьПромптАнализаОшибки(Запрос, ДополнительныеПараметры) Экспорт
	ТекстОшибки = "";
	Если Не СтроковыйАргумент(Запрос.Аргументы, "error_text", ТекстОшибки) Тогда
		Возврат ОшибкаОтсутствующегоАргумента("error_text");
	КонецЕсли;

	Возврат Мсп_Результаты.ТекстовыйПромпт(СтрШаблон(ТекстПромптаАнализаОшибки(), ТекстОшибки));
КонецФункции

// Формирует текст промпта analyze_error.
//
// Возвращаемое значение:
//  Строка - Текст промпта с подстановкой %1.
Функция ТекстПромптаАнализаОшибки()
	Строки = Новый Массив;
	Строки.Добавить("Проанализируй следующую ошибку 1С и помоги её исправить:");
	Строки.Добавить("");
	Строки.Добавить("%1");
	Строки.Добавить("");
	Строки.Добавить("Шаги:");
	Строки.Добавить("1. Определи тип ошибки (синтаксическая, ошибка времени выполнения, ошибка запроса, "
		+ "ошибка блокировки, ошибка прав доступа)");
	Строки.Добавить("2. Если ошибка указывает на конкретный объект метаданных -- используй get_object_structure "
		+ "для просмотра его структуры");
	Строки.Добавить("3. Если ошибка связана с запросом -- используй execute_query для проверки запроса");
	Строки.Добавить("4. Объясни:");
	Строки.Добавить("   - Причину ошибки");
	Строки.Добавить("   - В каких условиях она возникает");
	Строки.Добавить("   - Как её исправить (с примером кода)");
	Строки.Добавить("   - Как предотвратить подобные ошибки в будущем");
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Формирует описание инструмента get_event_log.
//
// Возвращаемое значение:
//  Строка - Описание инструмента.
Функция ОписаниеИнструментаЖурналаРегистрации()
	Возврат "Прочитать журнал регистрации 1С — лог ошибок, действий пользователей и системных событий. "
		+ "Фильтрация по дате, уровню важности (Ошибка/Предупреждение/Информация/Примечание) и пользователю.";
КонецФункции

// Формирует схему параметров инструмента get_event_log.
//
// Возвращаемое значение:
//  Структура - Схема параметров.
Функция СхемаИнструментаЖурналаРегистрации()
	Уровни = Новый Массив;
	Уровни.Добавить("Ошибка");
	Уровни.Добавить("Предупреждение");
	Уровни.Добавить("Информация");
	Уровни.Добавить("Примечание");

	Свойства = Новый Структура;
	Свойства.Вставить("start_date", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Начало периода в формате ISO 8601 (например 2026-03-01T00:00:00)"));
	Свойства.Вставить("end_date", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Конец периода в формате ISO 8601"));
	Свойства.Вставить("level", Мсп_СхемаПараметров.НовыйСвойствоСхемыСEnum("string",
		"Уровень важности: Ошибка, Предупреждение, Информация, Примечание", Уровни));
	Свойства.Вставить("user", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Имя пользователя 1С для фильтрации"));
	Свойства.Вставить("limit", Мсп_СхемаПараметров.НовыйСвойствоСхемы("integer",
		"Максимальное количество записей (по умолчанию 50, максимум 500)"));

	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Свойства, Неопределено);
КонецФункции

// Проверяет наличие непустого строкового аргумента.
//
// Параметры:
//  Аргументы - Структура - Аргументы вызова.
//  Имя - Строка - Имя аргумента.
//  Значение - Строка - Найденное значение аргумента.
//
// Возвращаемое значение:
//  Булево - Истина, если аргумент есть и непуст.
Функция СтроковыйАргумент(Аргументы, Имя, Значение)
	Если Не Аргументы.Свойство(Имя, Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Формирует ошибку отсутствия обязательного аргумента.
//
// Параметры:
//  Имя - Строка - Имя аргумента.
//
// Возвращаемое значение:
//  Структура - Ошибка инструмента.
Функция ОшибкаОтсутствующегоАргумента(Имя)
	Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS",
		СтрШаблон("missing required argument ""%1""", Имя));
КонецФункции

// Преобразует исключение серверного модуля в ошибку инструмента.
//
// Параметры:
//  ТекстОшибки - Строка - Описание исключения.
//
// Возвращаемое значение:
//  Структура - Ошибка инструмента.
Функция ОшибкаСервера(ТекстОшибки)
	Если СтрНайти(ТекстОшибки, "Object not found") > 0 Или СтрНайти(ТекстОшибки, "Form not found") > 0 Тогда
		Возврат Мсп_Сервер.ОшибкаИнструмента("NOT_FOUND", ТекстОшибки);
	КонецЕсли;
	Если СтрНайти(ТекстОшибки, "reading the event log requires") > 0 Тогда
		Возврат Мсп_Сервер.ОшибкаИнструмента("ACTION_DENIED", ТекстОшибки);
	КонецЕсли;
	Возврат Мсп_Сервер.ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
КонецФункции

#КонецОбласти
