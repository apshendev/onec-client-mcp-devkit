#Область ПрограммныйИнтерфейс

// Компилирует текст модуля во внешнюю обработку: загружает бинарный шаблон EPF из
// общего макета Мспи_ШаблонОбработки, подменяет текст модуля объекта и собирает
// обработку заново.
//
// Параметры:
//  ТекстМодуля - Строка - Полный текст модуля объекта внешней обработки.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Данные внешней обработки (.epf) с подменённым модулем.
//
// Вызывает исключение:
//  При некорректном контейнере шаблона и ошибках упаковки.
Функция СкомпилироватьМодуль(Знач ТекстМодуля) Экспорт

	ДанныеШаблона = ПолучитьОбщийМакет("Мспи_ШаблонОбработки");
	ПараметрыЗаписи = ПараметрыЗаписиКонтейнера();

	Поток = ДанныеШаблона.ОткрытьПотокДляЧтения();
	Попытка
		Оглавление = ПрочитатьКонтейнер(Поток, ПараметрыЗаписи, Истина);
		Поток.Закрыть();
	Исключение
		Поток.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	УстановитьТекстФайлаКонтейнера(Оглавление,
		ИдентификаторМодуляОбъектаШаблона() + "/text", ТекстМодуля);

	ПотокЗаписи = Новый ПотокВПамяти();
	ЗаписатьКонтейнер(ПотокЗаписи, Оглавление, ПараметрыЗаписи, Истина);

	Возврат ПотокЗаписи.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

// Компилирует и подключает внешнюю обработку с заданным текстом модуля объекта.
// Синтаксическая ошибка в тексте модуля вызывает исключение с номером строки.
//
// Параметры:
//  ТекстМодуля - Строка - Полный текст модуля объекта внешней обработки.
//
// Возвращаемое значение:
//  Строка - Имя подключённой обработки для ВнешниеОбработки.Создать.
//
// Вызывает исключение:
//  При синтаксической ошибке модуля (с координатой строки) и ошибках подключения.
Функция ПодключитьОбработку(Знач ТекстМодуля) Экспорт

	Данные = СкомпилироватьМодуль(ТекстМодуля);

	Возврат ВнешниеОбработки.Подключить(ПоместитьВоВременноеХранилище(Данные));

КонецФункции

// Создаёт новый REPL-сеанс: адрес временного хранилища со значением-Соответствие
// (Состояние сеанса). Вызывается repl_create; адрес и есть идентификатор repl_id.
//
// Возвращаемое значение:
//  Строка - Адрес временного хранилища со Состоянием сеанса.
Функция СоздатьСеанс() Экспорт

	Возврат ПоместитьВоВременноеХранилище(Новый Соответствие, Новый УникальныйИдентификатор());

КонецФункции

// Закрывает REPL-сеанс, удаляя Состояние из временного хранилища. Вызывается repl_close.
// Идемпотентен: закрытие уже закрытого (несуществующего) сеанса возвращает Ложь.
//
// Параметры:
//  Адрес - Строка - Адрес временного хранилища со Состоянием сеанса (repl_id).
//
// Возвращаемое значение:
//  Булево - Истина, если сеанс существовал и был закрыт.
Функция ЗакрытьСеанс(Знач Адрес) Экспорт

	Закрыт = Ложь;
	Попытка
		Закрыт = ТипЗнч(ПолучитьИзВременногоХранилища(Адрес)) = Тип("Соответствие");
	Исключение
		// Некорректный адрес хранилища эквивалентен уже закрытому сеансу.
	КонецПопытки;
	Если Закрыт Тогда
		УдалитьИзВременногоХранилища(Адрес);
	КонецЕсли;

	Возврат Закрыт;

КонецФункции

// Исполняет фрагмент BSL в сеансе REPL. Контракт - docs/specs/repl.md: классификация
// (module/statements/expression), препроцессор вырезания управления транзакциями,
// исполнение в транзакции с безусловным откатом, запись Состояния во временное
// хранилище строго после отката, structured-ответ.
//
// Параметры:
//  Адрес - Строка - Адрес временного хранилища сеанса из СоздатьСеанс;
//  Код - Строка - Фрагмент BSL (выражение, операторы или модуль с подпрограммами);
//  ИмяМетода - Строка, Неопределено - Имя экспортного метода для вызова (module);
//  Аргументы - Структура, Неопределено - Аргументы вызова метода по имени.
//
// Возвращаемое значение:
//  Структура - Поля status, mode, value, error, rolled_back, duration_ms по контракту.
Функция Исполнить(Знач Адрес, Знач Код, Знач ИмяМетода = Неопределено, Знач Аргументы = Неопределено) Экспорт

	Ответ = НовыйОтветREPL();
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Если ТипЗнч(Адрес) <> Тип("Строка") Или ПустаяСтрока(Адрес) Тогда
		Возврат ОтветСОшибкойREPL(Ответ, "invalid_argument", "repl_id is required", ВремяНачала, 0);
	КонецЕсли;

	Если ТипЗнч(Код) <> Тип("Строка") Или ПустаяСтрока(Код) Тогда
		Возврат ОтветСОшибкойREPL(Ответ, "invalid_argument", "code is required", ВремяНачала, 0);
	КонецЕсли;

	Если ИмяМетода <> Неопределено Тогда
		Если ТипЗнч(ИмяМетода) <> Тип("Строка") Тогда
			Возврат ОтветСОшибкойREPL(Ответ, "invalid_argument", "method must be a string", ВремяНачала, 0);
		КонецЕсли;
		ИмяМетода = СокрЛП(ИмяМетода);
		Если ПустаяСтрока(ИмяМетода) Тогда
			Возврат ОтветСОшибкойREPL(Ответ, "invalid_argument", "method must not be empty", ВремяНачала, 0);
		КонецЕсли;
		Если НЕ ЭтоИмяМетода(ИмяМетода) Тогда
			Возврат ОтветСОшибкойREPL(Ответ, "invalid_argument",
				"method must be an identifier: " + ИмяМетода, ВремяНачала, 0);
		КонецЕсли;
		Если Аргументы = Неопределено Тогда
			Аргументы = Новый Структура;
		КонецЕсли;
	КонецЕсли;

	Если Аргументы <> Неопределено И ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Возврат ОтветСОшибкойREPL(Ответ, "invalid_argument", "arguments must be an object", ВремяНачала, 0);
	КонецЕсли;

	Состояние = Неопределено;
	Попытка
		Состояние = ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		// Некорректный адрес хранилища эквивалентен отсутствию сеанса.
	КонецПопытки;
	Если ТипЗнч(Состояние) <> Тип("Соответствие") Тогда
		Возврат ОтветСОшибкойREPL(Ответ, "session_not_found",
			"session not found or already closed", ВремяНачала, 0);
	КонецЕсли;

	ПодготовленныйКод = ВырезатьУправлениеТранзакциями(Код);
	Режим = КлассифицироватьФрагмент(ПодготовленныйКод, Состояние);
	Ответ.mode = Режим;

	// Компиляция вне транзакции: ошибки компиляции не должны открывать транзакцию
	// и не меняют Состояние.
	ПодготовкаМодуля = Неопределено;
	Если Режим = "module" Тогда
		ПодготовкаМодуля = ПодготовитьФрагментМодуля(ПодготовленныйКод, ИмяМетода, Аргументы);
		Если НЕ ПодготовкаМодуля.OK Тогда
			Возврат ОтветСОшибкойREPL(Ответ, ПодготовкаМодуля.ВидОшибки,
				ПодготовкаМодуля.Сообщение, ВремяНачала, ПодготовкаМодуля.СтрокаОшибки);
		КонецЕсли;
	ИначеЕсли Режим = "statements" Тогда
		Диагностика = ПроверитьКомпиляциюОператоров(ПодготовленныйКод, Состояние);
		Если Диагностика <> Неопределено Тогда
			НомерСтроки = 0;
			Если Диагностика.Свойство("line") Тогда
				НомерСтроки = Диагностика.line;
			КонецЕсли;
			Возврат ОтветСОшибкойREPL(Ответ, "compile_error",
				Диагностика.message, ВремяНачала, НомерСтроки);
		КонецЕсли;
	КонецЕсли;

	ЕстьЗначение = Ложь;
	ЗначениеРезультата = Неопределено;
	ОшибкаИсполнения = Неопределено;

	НачатьТранзакцию();
	Попытка
		Если Режим = "module" Тогда
			Если ИмяМетода <> Неопределено Тогда
				РезультатВызова = ВызватьМетодПодключённойОбработки(ПодготовкаМодуля, Аргументы);
				ЕстьЗначение = РезультатВызова.ЕстьЗначение;
				ЗначениеРезультата = РезультатВызова.Значение;
			КонецЕсли;
		ИначеЕсли Режим = "expression" Тогда
			ЗначениеРезультата = ИсполнитьВыражениеВОбёртке(ПодготовленныйКод, Состояние);
			ЕстьЗначение = Истина;
		Иначе
			РезультатОператоров = ИсполнитьОператорыВОбёртке(ПодготовленныйКод, Состояние);
			ЕстьЗначение = РезультатОператоров.ЕстьЗначение;
			ЗначениеРезультата = РезультатОператоров.Значение;
		КонецЕсли;
	Исключение
		ОшибкаИсполнения = ДиагностикаОшибкиREPL(ИнформацияОбОшибке(), "runtime_error");
	КонецПопытки;

	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
		Ответ.rolled_back = Истина;
	Иначе
		// Фрагмент сам закрыл транзакцию обёртки (вырезание пропустило вызов).
		Ответ.rolled_back = Ложь;
	КонецЕсли;

	// Запись Состояния - строго после отката: изменения, сделанные фрагментом до
	// ошибки, переживают откат.
	ПоместитьВоВременноеХранилище(Состояние, Адрес);

	Если ОшибкаИсполнения = Неопределено Тогда
		Ответ.Вставить("value", СериализоватьЗначениеREPL(ЗначениеРезультата, ЕстьЗначение));
	Иначе
		Ответ.Вставить("error", ОшибкаИсполнения);
		Ответ.status = "error";
	КонецЕсли;

	Ответ.duration_ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;

	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает идентификатор файла модуля объекта внутри контейнера шаблона EPF.
//
// Возвращаемое значение:
//  Строка - Идентификатор файла модуля объекта.
Функция ИдентификаторМодуляОбъектаШаблона()

	Возврат "00ab4620-8498-4b18-a4f8-18b53138fcb5.0";

КонецФункции

#Область ОбёрткиИсполнителя

// Обёртка движка выражений. Локальные переменные сведены к параметрам Код и
// Состояние: фрагмент видит только их, коллизия имён - штатная ошибка исполнения.
//
// Возвращаемое значение:
//  Произвольный - Значение выражения.
Функция ИсполнитьВыражениеВОбёртке(Код, Состояние)

	Возврат Вычислить(Код);

КонецФункции

// Обёртка движка операторов. После исполнения проверяет переменную Результат:
// присвоена фрагментом - её значение, иначе has_value=false.
//
// Переменная Результат объявлена статически: Выполнить резолвит имена по
// статической таблице метода, поэтому присваивание попадает в неё, а чтение
// после Выполнить - прямой статический доступ (Вычислить динамические
// переменные Выполнить не видит). Присваивание фрагментом значения, равного
// маркеру, даст has_value=false - задокументированная коллизия.
//
// Возвращаемое значение:
//  Структура - Поля ЕстьЗначение, Значение.
Функция ИсполнитьОператорыВОбёртке(Код, Состояние)

	Перем Результат;

	Результат = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Выполнить(Код);

	Если Результат = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000") Тогда
		Возврат Новый Структура("ЕстьЗначение, Значение", Ложь, Неопределено);
	КонецЕсли;

	Возврат Новый Структура("ЕстьЗначение, Значение", Истина, Результат);

КонецФункции

#КонецОбласти

#Область ПрепроцессорФрагмента

// Вырезает из фрагмента вызовы управления транзакцией (RU+EN): строка, чей первый
// значимый токен - одно из ключевых слов, удаляется целиком. Строковые литералы не
// затрагиваются: строки-продолжения и литералы не начинаются с ключевого слова.
// Обёртка - единоличный владелец транзакции.
//
// Параметры:
//  Код - Строка - Исходный фрагмент.
//
// Возвращаемое значение:
//  Строка - Фрагмент без транзакционных вызовов.
Функция ВырезатьУправлениеТранзакциями(Код)

	КлючевыеСлова = Новый Массив;
	КлючевыеСлова.Добавить("начатьтранзакцию");
	КлючевыеСлова.Добавить("зафиксироватьтранзакцию");
	КлючевыеСлова.Добавить("отменитьтранзакцию");
	КлючевыеСлова.Добавить("begintransaction");
	КлючевыеСлова.Добавить("committransaction");
	КлючевыеСлова.Добавить("rollbacktransaction");

	Строки = СтрРазделить(Код, Символы.ПС, Ложь);
	Оставшиеся = Новый Массив;

	Для Каждого Строка Из Строки Цикл
		Сжатая = СокрЛП(СтрЗаменить(Строка, Символы.Таб, " "));
		Если ЭтоВызовУправленияТранзакцией(Сжатая, КлючевыеСлова) Тогда
			Продолжить;
		КонецЕсли;
		Оставшиеся.Добавить(Строка);
	КонецЦикла;

	Возврат СтрСоединить(Оставшиеся, Символы.ПС);

КонецФункции

// Проверяет, что первый значимый токен строки - вызов управления транзакцией.
//
// Возвращаемое значение:
//  Булево - Строка является транзакционным вызовом.
Функция ЭтоВызовУправленияТранзакцией(СжатаяСтрока, КлючевыеСлова)

	Если ПустаяСтрока(СжатаяСтрока) Тогда
		Возврат Ложь;
	КонецЕсли;

	НижнийРегистр = НРег(СжатаяСтрока);
	Для Каждого Ключевое Из КлючевыеСлова Цикл
		Если НЕ СтрНачинаетсяС(НижнийРегистр, Ключевое) Тогда
			Продолжить;
		КонецЕсли;
		СимволПосле = Сред(НижнийРегистр, СтрДлина(Ключевое) + 1, 1);
		Возврат СимволПосле = "" Или СимволПосле = "(" Или СимволПосле = " " Или СимволПосле = ";";
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область КлассификацияФрагмента

// Классифицирует фрагмент: module | statements | expression (см. docs/specs/repl.md).
//
// Параметры:
//  Код - Строка - Фрагмент после препроцессора.
//  Состояние - Соответствие - Состояние сеанса (для резолвинга имён при пробной компиляции).
//
// Возвращаемое значение:
//  Строка - Режим исполнения.
Функция КлассифицироватьФрагмент(Код, Состояние)

	Если СодержитОбъявлениеПодпрограммы(Код) Тогда
		Возврат "module";
	КонецЕсли;
	Если ЭтоОдинокоеПрисваивание(Код) Тогда
		Возврат "statements";
	КонецЕсли;
	Если СкомпилировалосьКакВыражение(Код, Состояние) Тогда
		Возврат "expression";
	КонецЕсли;
	Возврат "statements";

КонецФункции

// Проверяет, что первая непустая строка (не комментарий) - объявление подпрограммы.
//
// Возвращаемое значение:
//  Булево - Фрагмент содержит объявление на верхнем уровне.
Функция СодержитОбъявлениеПодпрограммы(Код)

	Ключевые = Новый Массив;
	Ключевые.Добавить("процедура");
	Ключевые.Добавить("функция");
	Ключевые.Добавить("procedure");
	Ключевые.Добавить("function");

	КоличествоСтрок = СтрЧислоСтрок(Код);
	Для Индекс = 1 По КоличествоСтрок Цикл
		Строка = СокрЛП(СтрЗаменить(СтрПолучитьСтроку(Код, Индекс), Символы.Таб, " "));
		Если ПустаяСтрока(Строка) Или СтрНачинаетсяС(Строка, "//") Тогда
			Продолжить;
		КонецЕсли;
		НижнийРегистр = НРег(Строка);
		Для Каждого Ключевое Из Ключевые Цикл
			Если СтрНачинаетсяС(НижнийРегистр, Ключевое) Тогда
				СимволПосле = Сред(НижнийРегистр, СтрДлина(Ключевое) + 1, 1);
				Возврат СимволПосле = "" Или СимволПосле = " " Или СимволПосле = "(";
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет эвристику одиночного верхнеуровневого присваивания: ровно один "=" вне
// строковых литералов, строка с ним не начинается с ключевого слова блока, левая
// часть - имя, свойство или обращение по индексу.
//
// Возвращаемое значение:
//  Булево - Фрагмент классифицируется как операторы по присваиванию.
Функция ЭтоОдинокоеПрисваивание(Код)

	НайденоПрисваиваний = 0;
	ЛеваяЧасть = "";

	КоличествоСтрок = СтрЧислоСтрок(Код);
	Для Индекс = 1 По КоличествоСтрок Цикл
		Строка = СокрЛП(СтрЗаменить(СтрПолучитьСтроку(Код, Индекс), Символы.Таб, " "));
		Позиция = ПозицияПервогоРавноВнеЛитералов(Строка);
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НачинаетсяСКлючевогоСловаБлока(Строка) Тогда
			Продолжить;
		КонецЕсли;
		НайденоПрисваиваний = НайденоПрисваиваний + 1;
		Если НайденоПрисваиваний > 1 Тогда
			Возврат Ложь;
		КонецЕсли;
		ЛеваяЧасть = СокрЛП(Лев(Строка, Позиция - 1));
	КонецЦикла;

	Возврат НайденоПрисваиваний = 1 И ЭтоПрисваиваемаяЛеваяЧасть(ЛеваяЧасть);

КонецФункции

// Возвращает позицию первого "=" вне строковых литералов строки (учёт кавычек),
// 0 - если такого нет.
//
// Возвращаемое значение:
//  Число - Позиция "=" или 0.
Функция ПозицияПервогоРавноВнеЛитералов(Строка)

	ВЛитерале = Ложь;
	Длина = СтрДлина(Строка);
	Для Позиция = 1 По Длина Цикл
		Символ = Сред(Строка, Позиция, 1);
		Если Символ = """" Тогда
			ВЛитерале = НЕ ВЛитерале;
		ИначеЕсли Символ = "=" И НЕ ВЛитерале Тогда
			Возврат Позиция;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

// Проверяет, что строка начинается с ключевого слова блока (присваивание невозможно).
//
// Возвращаемое значение:
//  Булево - Строка начинается с ключевого слова блока.
Функция НачинаетсяСКлючевогоСловаБлока(СжатаяСтрока)

	Ключевые = "если,иначе,пока,для,возврат,процедура,функция,попытка,исключение,прервать,продолжить,if,else,while,for,return,procedure,function,try,except,break,continue";

	НижнийРегистр = НРег(СжатаяСтрока);
	КлючевыеСтрокой = СтрРазделить(Ключевые, ",");

	Для Каждого Ключевое Из КлючевыеСтрокой Цикл
		Если СтрНачинаетсяС(НижнийРегистр, Ключевое) Тогда
			СимволПосле = Сред(НижнийРегистр, СтрДлина(Ключевое) + 1, 1);
			Если СимволПосле = " " Или СимволПосле = "(" Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет, что левая часть присваивания - имя переменной, свойство объекта
// (цепочка через точку) или обращение по индексу.
//
// Возвращаемое значение:
//  Булево - Левая часть присваиваемая.
Функция ЭтоПрисваиваемаяЛеваяЧасть(ЛеваяЧасть)

	Если ПустаяСтрока(ЛеваяЧасть) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Обращение по индексу: ...[...] - последняя закрывающая скобка в конце.
	Если Прав(ЛеваяЧасть, 1) = "]" Тогда
		Возврат СтрНайти(ЛеваяЧасть, "[") > 0;
	КонецЕсли;

	// Имя или свойство: цепочка идентификаторов через точку.
	Части = СтрРазделить(ЛеваяЧасть, ".");
	Для Каждого Часть Из Части Цикл
		Если НЕ ЭтоИмяМетода(Часть) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет имя на идентификатор BSL (буквы/цифры/подчёркивание, не с цифры).
//
// Возвращаемое значение:
//  Булево - Строка является идентификатором.
Функция ЭтоИмяМетода(Имя)

	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Код = КодСимвола(Имя, Позиция);
		ЭтоБуква = (Код >= 65 И Код <= 90) Или (Код >= 97 И Код <= 122)
			Или (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105 Или Код = 95;
		ЭтоЦифра = Код >= 48 И Код <= 57;
		Если Позиция = 1 И ЭтоЦифра Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НЕ (ЭтоБуква Или ЭтоЦифра) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет компиляцию фрагмента как выражение без исполнения: мёртвая ветка.
// Состояние передаётся для резолвинга имён фрагмента при компиляции.
//
// Возвращаемое значение:
//  Булево - Фрагмент компилируется как выражение.
Функция СкомпилировалосьКакВыражение(Код, Состояние)

	Фрагмент = "Если Ложь Тогда" + Символы.ПС
		+ "РезультатВыражения = (" + Код + ");" + Символы.ПС
		+ "КонецЕсли;";

	Попытка
		Выполнить(Фрагмент);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Проверяет компиляцию фрагмента операторов без исполнения (мёртвая ветка).
// Состояние передаётся для резолвинга имён фрагмента при компиляции.
// Возвращает Неопределено при успешной компиляции или диагностику compile_error
// (координата строки смещена на +1 строкой обёртки - компенсируется).
//
// Возвращаемое значение:
//  Структура, Неопределено - Диагностика {kind, message, line}.
Функция ПроверитьКомпиляциюОператоров(Код, Состояние)

	Фрагмент = "Если Ложь Тогда" + Символы.ПС + Код + Символы.ПС + "КонецЕсли;";

	Попытка
		Выполнить(Фрагмент);
		Возврат Неопределено;
	Исключение
		Диагностика = ДиагностикаОшибкиREPL(ИнформацияОбОшибке(), "compile_error");
		Если Диагностика.Свойство("line") И Диагностика.line > 0 Тогда
			Диагностика.line = Диагностика.line - 1;
		КонецЕсли;
		Возврат Диагностика;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ДвижокМодуля

// Компилирует фрагмент-модуль и подготавливает вызов метода: разбор сигнатуры,
// проверка соответствия аргументов, подключение обработки. Ошибки возвращаются
// структурой, а не исключением, чтобы не открывать транзакцию.
//
// Параметры:
//  Код - Строка - Фрагмент после препроцессора;
//  ИмяМетода - Строка, Неопределено - Имя вызываемого экспортного метода;
//  Аргументы - Структура, Неопределено - Аргументы вызова по имени.
//
// Возвращаемое значение:
//  Структура - Поля OK, ВидОшибки, Сообщение, СтрокаОшибки, ИмяОбработки, Вид, Параметры.
Функция ПодготовитьФрагментМодуля(Код, ИмяМетода, Аргументы)

	Ответ = Новый Структура("OK, ВидОшибки, Сообщение, СтрокаОшибки, ИмяОбработки, Вид, Имя, Параметры",
		Ложь, "", "", 0, "", "", "", Новый Массив);

	Если ИмяМетода = Неопределено Тогда
		Попытка
			Ответ.ИмяОбработки = ПодключитьОбработку(Код);
			// Подключить не компилирует модуль объекта - верифицируем созданием,
			// чтобы синтаксическая ошибка осталась compile_error вне транзакции.
			ВнешниеОбработки.Создать(Ответ.ИмяОбработки);
		Исключение
			Диагностика = ДиагностикаОшибкиREPL(ИнформацияОбОшибке(), "compile_error");
			Ответ.ВидОшибки = "compile_error";
			Ответ.Сообщение = Диагностика.message;
			Ответ.СтрокаОшибки = 0;
			Если Диагностика.Свойство("line") Тогда
				Ответ.СтрокаОшибки = Диагностика.line;
			КонецЕсли;
			Возврат Ответ;
		КонецПопытки;
		Ответ.OK = Истина;
		Возврат Ответ;
	КонецЕсли;

	Сигнатура = РазобратьСигнатуруМетода(Код, ИмяМетода);
	Если Сигнатура = Неопределено Тогда
		Ответ.ВидОшибки = "invalid_argument";
		Ответ.Сообщение = "method not found in module fragment: " + ИмяМетода;
		Возврат Ответ;
	КонецЕсли;

	ОшибкаСоответствия = ПроверитьСоответствиеАргументов(Сигнатура.Параметры, Аргументы);
	Если НЕ ПустаяСтрока(ОшибкаСоответствия) Тогда
		Ответ.ВидОшибки = "invalid_argument";
		Ответ.Сообщение = ОшибкаСоответствия;
		Возврат Ответ;
	КонецЕсли;

	Попытка
		Ответ.ИмяОбработки = ПодключитьОбработку(Код);
		// Верификация компиляции модуля объекта до транзакции (см. выше).
		ВнешниеОбработки.Создать(Ответ.ИмяОбработки);
	Исключение
		Диагностика = ДиагностикаОшибкиREPL(ИнформацияОбОшибке(), "compile_error");
		Ответ.ВидОшибки = "compile_error";
		Ответ.Сообщение = Диагностика.message;
		Ответ.СтрокаОшибки = 0;
		Если Диагностика.Свойство("line") Тогда
			Ответ.СтрокаОшибки = Диагностика.line;
		КонецЕсли;
		Возврат Ответ;
	КонецПопытки;

	Ответ.OK = Истина;
	Ответ.Вид = Сигнатура.Вид;
	Ответ.Имя = Сигнатура.Имя;
	Ответ.Параметры = Сигнатура.Параметры;

	Возврат Ответ;

КонецФункции

// Создаёт объект подключённой обработки и вызывает экспортный метод с аргументами
// по имени. Функция возвращает значение, процедура - has_value=false.
//
// Возвращаемое значение:
//  Структура - Поля ЕстьЗначение, Значение.
Функция ВызватьМетодПодключённойОбработки(Подготовка, Аргументы)

	Перем ЗначениеВызова;

	СтрокаПараметров = "";
	Для Каждого ИмяПараметра Из Подготовка.Параметры Цикл
		Если СтрокаПараметров <> "" Тогда
			СтрокаПараметров = СтрокаПараметров + ", ";
		КонецЕсли;
		СтрокаПараметров = СтрокаПараметров + "Аргументы." + ИмяПараметра;
	КонецЦикла;

	Объект = ВнешниеОбработки.Создать(Подготовка.ИмяОбработки);

	Если Подготовка.Вид = "Функция" Тогда
		Выполнить("ЗначениеВызова = Объект." + Подготовка.Имя
			+ "(" + СтрокаПараметров + ");");
		Возврат Новый Структура("ЕстьЗначение, Значение", Истина, ЗначениеВызова);
	КонецЕсли;

	Выполнить("Объект." + Подготовка.Имя + "(" + СтрокаПараметров + ");");
	Возврат Новый Структура("ЕстьЗначение, Значение", Ложь, Неопределено);

КонецФункции

// Разыскивает объявление метода по имени и разбирает параметры (порт разбора
// сигнатуры из Мсп_ИнструментыКодаСервер.ПроверитьКод). Комментарии пропускаются.
//
// Параметры:
//  Код - Строка - Текст модуля;
//  ИмяМетода - Строка - Имя разыскиваемого метода.
//
// Возвращаемое значение:
//  Структура, Неопределено - Поля Вид, Имя, Параметры.
Функция РазобратьСигнатуруМетода(Код, ИмяМетода)

	Сигнатура = Неопределено;

	КоличествоСтрок = СтрЧислоСтрок(Код);
	Для Индекс = 1 По КоличествоСтрок Цикл
		Строка = СокрЛП(СтрЗаменить(СтрПолучитьСтроку(Код, Индекс), Символы.Таб, " "));
		Если ПустаяСтрока(Строка) Или СтрНачинаетсяС(Строка, "//") Тогда
			Продолжить;
		КонецЕсли;

		НижнийРегистр = НРег(Строка);
		Если СтрНачинаетсяС(НижнийРегистр, "функция ") Тогда
			ВидМетода = "Функция";
			ДлинаКлючевого = СтрДлина("функция ");
		ИначеЕсли СтрНачинаетсяС(НижнийРегистр, "процедура ") Тогда
			ВидМетода = "Процедура";
			ДлинаКлючевого = СтрДлина("процедура ");
		ИначеЕсли СтрНачинаетсяС(НижнийРегистр, "function ") Тогда
			ВидМетода = "Функция";
			ДлинаКлючевого = СтрДлина("function ");
		ИначеЕсли СтрНачинаетсяС(НижнийРегистр, "procedure ") Тогда
			ВидМетода = "Процедура";
			ДлинаКлючевого = СтрДлина("procedure ");
		Иначе
			Продолжить;
		КонецЕсли;

		Остаток = СокрЛП(Сред(Строка, ДлинаКлючевого + 1));
		ПозицияСкобки = СтрНайти(Остаток, "(");
		Если ПозицияСкобки = 0 Тогда
			Продолжить;
		КонецЕсли;
		ОбъявленноеИмя = СокрЛП(Лев(Остаток, ПозицияСкобки - 1));
		Если НРег(ОбъявленноеИмя) <> НРег(ИмяМетода) Тогда
			Продолжить;
		КонецЕсли;

		ПозицияЗакрытия = СтрНайти(Остаток, ")", , ПозицияСкобки);
		Внутри = "";
		Если ПозицияЗакрытия > 0 Тогда
			Внутри = Сред(Остаток, ПозицияСкобки + 1, ПозицияЗакрытия - ПозицияСкобки - 1);
		КонецЕсли;

		Сигнатура = Новый Структура;
		Сигнатура.Вставить("Вид", ВидМетода);
		Сигнатура.Вставить("Имя", ОбъявленноеИмя);
		Сигнатура.Вставить("Параметры", РазобратьИменаПараметров(Внутри));
		Прервать;
	КонецЦикла;

	Возврат Сигнатура;

КонецФункции

// Разбирает список имён параметров из текста в скобках объявления: отбрасывает
// квалификатор Знач, значения по умолчанию после "=", хвостовой Экспорт.
//
// Возвращаемое значение:
//  Массив из Строка - Имена параметров.
Функция РазобратьИменаПараметров(Внутри)

	Параметры = Новый Массив;
	Если ПустаяСтрока(Внутри) Тогда
		Возврат Параметры;
	КонецЕсли;

	Части = СтрРазделить(Внутри, ",");
	Для Каждого Часть Из Части Цикл
		Параметр = СокрЛП(Часть);
		Если СтрНачинаетсяС(НРег(Параметр), "знач ") Тогда
			Параметр = СокрЛП(Сред(Параметр, СтрДлина("знач ") + 1));
		КонецЕсли;
		Если СтрНачинаетсяС(НРег(Параметр), "val ") Тогда
			Параметр = СокрЛП(Сред(Параметр, СтрДлина("val ") + 1));
		КонецЕсли;
		ПозицияРавно = СтрНайти(Параметр, "=");
		Если ПозицияРавно > 0 Тогда
			Параметр = СокрЛП(Лев(Параметр, ПозицияРавно - 1));
		КонецЕсли;
		Если НРег(Параметр) = "экспорт" Или НРег(Параметр) = "export" Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПустаяСтрока(Параметр) Тогда
			Параметры.Добавить(Параметр);
		КонецЕсли;
	КонецЦикла;

	Возврат Параметры;

КонецФункции

// Возвращает пустую строку, если ключи аргументов точно совпадают (без учёта
// регистра) с именами параметров метода, иначе - читаемый текст ошибки.
// Порт проверки из Мсп_ИнструментыКодаСервер.ПроверитьКод.
//
// Возвращаемое значение:
//  Строка - Текст ошибки соответствия или пустая строка.
Функция ПроверитьСоответствиеАргументов(ПараметрыМетода, Аргументы)

	Если Аргументы = Неопределено Тогда
		Аргументы = Новый Структура;
	КонецЕсли;

	Для Каждого ИмяПараметра Из ПараметрыМетода Цикл
		Если НЕ Аргументы.Свойство(ИмяПараметра) Тогда
			Возврат "missing argument for parameter: " + ИмяПараметра;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Элемент Из Аргументы Цикл
		Найден = Ложь;
		Для Каждого ИмяПараметра Из ПараметрыМетода Цикл
			Если ВРег(Элемент.Ключ) = ВРег(ИмяПараметра) Тогда
				Найден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найден Тогда
			Возврат "unexpected argument: " + Элемент.Ключ;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область СериализацияИОтвет

// Формирует каркас structured-ответа repl_eval.
//
// Возвращаемое значение:
//  Структура - Поля status, mode, rolled_back, duration_ms.
Функция НовыйОтветREPL()

	Ответ = Новый Структура;
	Ответ.Вставить("status", "ok");
	Ответ.Вставить("mode", "");
	Ответ.Вставить("rolled_back", Ложь);
	Ответ.Вставить("duration_ms", 0);

	Возврат Ответ;

КонецФункции

// Заполняет ответ ошибкой и длительностью.
//
// Возвращаемое значение:
//  Структура - Ответ с ошибкой.
Функция ОтветСОшибкойREPL(Ответ, Вид, Сообщение, ВремяНачала, СтрокаОшибки)

	Ошибка = Новый Структура("kind,message", Вид, Сообщение);
	Если СтрокаОшибки > 0 Тогда
		Ошибка.Вставить("line", СтрокаОшибки);
	КонецЕсли;
	Ответ.Вставить("error", Ошибка);
	Ответ.status = "error";
	Ответ.duration_ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;

	Возврат Ответ;

КонецФункции

// Сериализует значение по контракту docs/specs/repl.md: примитивы - типизированный
// JSON, коллекции - попытка JSON, остальное - только тип и представление.
//
// Параметры:
//  Значение - Произвольный - Значение фрагмента;
//  ЕстьЗначение - Булево - Возвращает ли фрагмент значение.
//
// Возвращаемое значение:
//  Структура - Поля has_value, type, presentation, json.
Функция СериализоватьЗначениеREPL(Значение, ЕстьЗначение)

	Если НЕ ЕстьЗначение Тогда
		Возврат Новый Структура("has_value", Ложь);
	КонецЕсли;

	Результат = Новый Структура("has_value", Истина);
	Результат.Вставить("type", Строка(ТипЗнч(Значение)));
	Результат.Вставить("presentation", ОбрезатьПредставление(Строка(Значение)));

	ТипЗначения = ТипЗнч(Значение);
	ЕстьJSON = Ложь;
	JSONЗначение = Неопределено;

	Если ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Булево") Тогда
		ЕстьJSON = Истина;
		JSONЗначение = Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		ЕстьJSON = Истина;
		JSONЗначение = XMLСтрока(Значение);
	ИначеЕсли Значение = Неопределено Или Значение = NULL Тогда
		ЕстьJSON = Истина;
	ИначеЕсли ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("Соответствие") Тогда
		Если СериализуетсяВJSON(Значение) Тогда
			ЕстьJSON = Истина;
			JSONЗначение = Значение;
		КонецЕсли;
	КонецЕсли;

	Если ЕстьJSON Тогда
		Результат.Вставить("json", JSONЗначение);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверяет сериализуемость значения в JSON пробной записью.
//
// Возвращаемое значение:
//  Булево - Значение сериализуется в JSON.
Функция СериализуетсяВJSON(Значение)

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Значение);
		ЗаписьJSON.Закрыть();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Обрезает представление значения до ~4096 символов.
//
// Возвращаемое значение:
//  Строка - Представление.
Функция ОбрезатьПредставление(Строка)

	Максимум = 4096;
	Если СтрДлина(Строка) <= Максимум Тогда
		Возврат Строка;
	КонецЕсли;

	Возврат Лев(Строка, Максимум);

КонецФункции

// Разбирает текст ошибки платформы и возвращает структуру {kind, message, line?}:
// последняя координата "{Модуль(N[,M])}" (порт разбора из ПроверитьКод).
//
// Параметры:
//  Инфо - ИнформацияОбОшибке - Ошибка платформы;
//  Вид - Строка - Код ошибки контракта.
//
// Возвращаемое значение:
//  Структура - Диагностика.
Функция ДиагностикаОшибкиREPL(Инфо, Вид)

	Диагностика = Новый Структура("kind,message", Вид, КраткоеПредставлениеОшибки(Инфо));

	// Подробное представление содержит стек вызовов с координатами "{Модуль(N,M)}";
	// в кратком представлении (и в ОписаниеОшибки) координат нет.
	ТекстОшибки = ПодробноеПредставлениеОшибки(Инфо);

	// Последняя фигурная скобка открывает самый глубокий блок с координатой.
	Позиция = 1;
	ПозицияФигурнойСкобки = 0;
	Пока Истина Цикл
		Найденная = СтрНайти(ТекстОшибки, "{", , Позиция);
		Если Найденная = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияФигурнойСкобки = Найденная;
		Позиция = Найденная + 1;
	КонецЦикла;

	Если ПозицияФигурнойСкобки = 0 Тогда
		Возврат Диагностика;
	КонецЕсли;

	ПозицияСкобки = СтрНайти(ТекстОшибки, "(", , ПозицияФигурнойСкобки);
	Если ПозицияСкобки = 0 Тогда
		Возврат Диагностика;
	КонецЕсли;
	ПозицияЗакрытия = СтрНайти(ТекстОшибки, ")", , ПозицияСкобки);
	Если ПозицияЗакрытия = 0 Тогда
		Возврат Диагностика;
	КонецЕсли;

	Внутри = Сред(ТекстОшибки, ПозицияСкобки + 1, ПозицияЗакрытия - ПозицияСкобки - 1);
	Части = СтрРазделить(Внутри, ",");
	Строка = 0;
	Если Части.Количество() >= 1 Тогда
		Попытка
			Строка = Число(СокрЛП(Части[0]));
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если Строка > 0 Тогда
		Диагностика.Вставить("line", Строка);
	КонецЕсли;

	Возврат Диагностика;

КонецФункции

#КонецОбласти

#Область КонтейнерВнешнейОбработки

// Область - порт контейнера внешней обработки из YaxUnit (обработка ЮТРедакторОбработки).
// Copyright 2021-2025 BIA-Technologies Limited Liability Company, лицензия Apache-2.0
// (http://www.apache.org/licenses/LICENSE-2.0); реализация на основании разработки
// https://infostart.ru/1c/tools/1691321/ by ZhokhovM. Контейнер - формат внутренних
// файлов внешней обработки 1С: оглавление адресов + блоки данных, вложенные контейнеры
// распаковываются рекурсивно, данные сжимаются deflate через ХранилищеЗначения.

// Читает контейнер внешней обработки: оглавление адресов и файлы (с распаковкой).
//
// Параметры:
//  Поток - Поток - Поток данных контейнера.
//  ПараметрыЗаписи - Структура - См. ПараметрыЗаписиКонтейнера.
//  Распаковывать - Булево - Распаковывать deflate-данные файлов.
//
// Возвращаемое значение:
//  Массив из Структура - Записи оглавления, см. ЗаписьОглавленияКонтейнера.
Функция ПрочитатьКонтейнер(Поток, ПараметрыЗаписи, Распаковывать)

	РазмерЗаголовкаКонтейнера = 16;

	ПотокОглавления = ПотокДокумента(Поток, ПараметрыЗаписи, РазмерЗаголовкаКонтейнера);
	Оглавление = ДанныеОглавления(ПотокОглавления, ПараметрыЗаписи); // Пропускаем заголовок контейнера - 16 байт
	ПотокОглавления.Закрыть();

	ЗагрузитьФайлыКонтейнера(Поток, ПараметрыЗаписи, Оглавление, Распаковывать);

	Возврат Оглавление;

КонецФункции

// Заполняет имена и данные файлов по адресам из оглавления; вложенные контейнеры
// читает рекурсивно.
Процедура ЗагрузитьФайлыКонтейнера(Поток, ПараметрыЗаписи, Оглавление, Распаковывать)

	Для Каждого Запись Из Оглавление Цикл
		Запись.ИмяФайла = ИмяФайлаИзАтрибутов(Поток, ПараметрыЗаписи, Запись.АдресЗаголовкаФайла);
		Данные = ДанныеФайлаКонтейнера(Поток, ПараметрыЗаписи, Запись.АдресТелаФайла, Распаковывать);
		Запись.ЭтоКонтейнер = ЭтоКонтейнер(Данные);

		Если Запись.ЭтоКонтейнер Тогда
			ВложенныйПоток = Данные.ОткрытьПотокДляЧтения();
			ДанныеКонтейнера = ПрочитатьКонтейнер(ВложенныйПоток, ПараметрыЗаписи, Ложь);
			ВложенныйПоток.Закрыть();
			Запись.Данные = ДанныеКонтейнера;
		Иначе
			Запись.Данные = Данные;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Читает имя файла из блока атрибутов файла (20 байт дат + имя UTF16 до нуль-символа).
//
// Возвращаемое значение:
//  Строка - Имя файла.
Функция ИмяФайлаИзАтрибутов(Поток, ПараметрыЗаписи, АдресАтрибутовФайла)

	РазмерБлокаДат = 20;

	ПотокАтрибутыФайла = ПотокДокумента(Поток, ПараметрыЗаписи, АдресАтрибутовФайла);
	Чтение = Новый ЧтениеДанных(ПотокАтрибутыФайла, КодировкаТекста.UTF16, ПорядокБайтов.LittleEndian, , Символ(0));
	Чтение.Пропустить(РазмерБлокаДат); // Атрибуты
	ИмяФайла = СокрП(Чтение.ПрочитатьСтроку());
	ПотокАтрибутыФайла.Закрыть();

	Возврат ИмяФайла;

КонецФункции

// Читает данные файла по адресу; при необходимости распаковывает.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Данные файла.
Функция ДанныеФайлаКонтейнера(Поток, ПараметрыЗаписи, АдресДанныеФайла, Распаковать)

	ПотокДанные = ПотокДокумента(Поток, ПараметрыЗаписи, АдресДанныеФайла);
	Данные = ПотокДанные.ЗакрытьИПолучитьДвоичныеДанные();
	ПотокДанные.Закрыть();

	Если Распаковать Тогда
		Данные = РаспаковатьДанныеКонтейнера(Данные);
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Распаковывает deflate-данные файла: платформа упаковывает их как ХранилищеЗначения,
// поэтому перед распаковкой дописывается стандартный заголовк хранилища.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Распакованные данные.
Функция РаспаковатьДанныеКонтейнера(Знач ДвоичныеДанные)

	// BSLLS:MagicNumber-off
	// Литерал собран конкатенацией однострочных частей: многострочный литерал содержит
	// переносы CRLF, на которых Base64Значение в совместимости 8.3.16+ обрезает декодирование.
	Заголовок64 = "AgFTS2/0iI3BTqDV67a9oKcNAFEArv89AAAAAAAAAO+7v3siIyIsODcxMjYyMDAt"
		+ "M2U5OC00NGUwLWI5MzEtY2NiMWQ3ZWRjNDk3LA0KezEsDQp7MH0NCn0NCn0AAAAA"
		+ "//////////8=";
	// BSLLS:MagicNumber-on
	ЗаголовокДляХранилищаЗначения = Base64Значение(Заголовок64);

	Поток = Новый ПотокВПамяти;
	ПотокЗаголовка = ЗаголовокДляХранилищаЗначения.ОткрытьПотокДляЧтения();
	ПотокЗаголовка.КопироватьВ(Поток);
	ПотокЗаголовка.Закрыть();
	ПотокДанных = ДвоичныеДанные.ОткрытьПотокДляЧтения();
	ПотокДанных.КопироватьВ(Поток);
	ПотокДанных.Закрыть();
	СводныйФайл = Поток.ЗакрытьИПолучитьДвоичныеДанные();
	// Функция ПолучитьBase64СтрокуИзДвоичныхДанных разбивает текст переносами CR+LF каждые
	// 64 символа, а XMLЗначение в режиме совместимости 8.3.16+ переносов не допускает -
	// удаляем разделители строк перед декодированием.
	Строка64 = СтрЗаменить(СтрЗаменить(ПолучитьBase64СтрокуИзДвоичныхДанных(СводныйФайл),
		Символы.ВК + Символы.ПС, ""), Символы.ПС, "");
	ХранилищеЗначения = XMLЗначение(Тип("ХранилищеЗначения"), Строка64);

	Попытка
		РаспакованныеДанные = ХранилищеЗначения.Получить();
	Исключение
		РаспакованныеДанные = ПолучитьДвоичныеДанныеИзHexСтроки("");
	КонецПопытки;

	Возврат РаспакованныеДанные;

КонецФункции

// Читает заголовок блока: 0D 0A, размер файла, размер блока, адрес следующего блока.
//
// Возвращаемое значение:
//  Структура - Поля ДлинаФайла, ДлинаБлока, СледующийБлок.
Функция ЗаголовокБлокаКонтейнера(Чтение)

	ВозвратКаретки = 13;
	ПереносСтроки = 10;

	Если Чтение.ПрочитатьБайт() <> ВозвратКаретки Или Чтение.ПрочитатьБайт() <> ПереносСтроки Тогда
		ВызватьИсключение "Заголовок блока должен начинаться с `0D 0A`";
	КонецЕсли;

	ДлинаФайла = ЧислоЗаголовкаБлока(Чтение);
	Чтение.Пропустить(1); // Пробел 20
	ДлинаБлока = ЧислоЗаголовкаБлока(Чтение);
	Чтение.Пропустить(1); // Пробел 20
	СледующийБлок = ЧислоЗаголовкаБлока(Чтение);
	Чтение.Пропустить(3); // 20 0D 0A

	Чтение.Закрыть();

	Возврат Новый Структура("ДлинаФайла, ДлинаБлока, СледующийБлок", ДлинаФайла, ДлинаБлока, СледующийБлок);

КонецФункции

// Собирает документ из цепочки блоков контейнера по адресу первого блока.
//
// Возвращаемое значение:
//  Поток - Поток документа в памяти.
Функция ПотокДокумента(ВходнойПоток, ПараметрыЗаписи, АдресБлока)

	ОсталосьПрочитать = -1;

	СледующийБлок = АдресБлока;
	МаксимальноеЦелоеЧисло = ПараметрыЗаписи.МаксимальноеЦелоеЧисло;
	ЭтоПервыйБлок = Истина;

	Пока СледующийБлок < МаксимальноеЦелоеЧисло Цикл

		Если НЕ ЭтоПервыйБлок Или ОсталосьПрочитать = 0 Тогда
			ВызватьИсключение "Ошибка чтения потока из контейнера. Все байты прочитаны, но цепочка блоков не кончилась.";
		КонецЕсли;

		ВходнойПоток.Перейти(СледующийБлок, ПозицияВПотоке.Начало);
		Чтение = Новый ЧтениеДанных(ВходнойПоток, КодировкаТекста.ANSI, ПорядокБайтов.LittleEndian);

		Заголовок = ЗаголовокБлокаКонтейнера(Чтение);
		СледующийБлок = Заголовок.СледующийБлок;

		Если Заголовок.ДлинаБлока = 0 Тогда
			ВызватьИсключение "Ошибка чтения потока из контейнера. Длина блока = 0.";
		КонецЕсли;

		Если ЭтоПервыйБлок Тогда
			ОсталосьПрочитать = Заголовок.ДлинаФайла;
			ПотокЗаписи = Новый ПотокВПамяти(Заголовок.ДлинаФайла);
			Запись = Новый ЗаписьДанных(ПотокЗаписи); // собираем документ из нескольких блоков
			ЭтоПервыйБлок = Ложь;
		КонецЕсли;

		Читаем = Мин(Заголовок.ДлинаБлока, ОсталосьПрочитать);
		Буфер = Чтение.ПрочитатьВБуферДвоичныхДанных(Читаем);
		Чтение.Закрыть();
		Запись.ЗаписатьБуферДвоичныхДанных(Буфер);
		ОсталосьПрочитать = ОсталосьПрочитать - Читаем;
	КонецЦикла;

	Запись.Закрыть();

	Если ОсталосьПрочитать > 0 Тогда
		ВызватьИсключение "Ошибка чтения потока из контейнера. Поток не считан до конца, но цепочка блоков закончилась.";
	КонецЕсли;

	ПотокЗаписи.Перейти(0, ПозицияВПотоке.Начало);

	Возврат ПотокЗаписи;

КонецФункции

// Читает оглавление контейнера: тройки целое32 (адрес заголовка, адрес тела,
// разделитель) до конца потока.
//
// Возвращаемое значение:
//  Массив из Структура - Записи оглавления.
Функция ДанныеОглавления(Поток, ПараметрыЗаписи)

	Чтение = Новый ЧтениеДанных(Поток, , ПорядокБайтов.LittleEndian);
	Оглавление = Новый Массив;

	Пока Истина Цикл

		Запись = ЗаписьОглавленияКонтейнера();
		Запись.АдресЗаголовкаФайла = Чтение.ПрочитатьЦелое32();

		Если Запись.АдресЗаголовкаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Запись.АдресТелаФайла = Чтение.ПрочитатьЦелое32();
		Чтение.Пропустить(ПараметрыЗаписи.РазмерПоляАдресации); // 4 байта зарезервированное поле (7FFFFFFF)

		Оглавление.Добавить(Запись);

	КонецЦикла;

	Возврат Оглавление;

КонецФункции

// Читает 8-символьное шестнадцатеричное число заголовка блока.
//
// Возвращаемое значение:
//  Число - Значение поля заголовка.
Функция ЧислоЗаголовкаБлока(Чтение)

	РазмерПоля = 8;
	Значение = "0x" + Чтение.ПрочитатьСимволы(РазмерПоля);

	Возврат ЧислоИзШестнадцатеричнойСтроки(Значение);

КонецФункции

// Проверяет признак контейнера во входных данных (первое целое32 = 7FFFFFFF).
//
// Возвращаемое значение:
//  Булево - Данные являются вложенным контейнером.
Функция ЭтоКонтейнер(Данные)

	МаксимальноеЦелоеЧисло = 2147483647;
	Чтение = Новый ЧтениеДанных(Данные);
	Флаг = Чтение.ПрочитатьЦелое32();
	Чтение.Закрыть();

	Возврат Флаг = МаксимальноеЦелоеЧисло;

КонецФункции

// Записывает контейнер: заголовок, файлы, оглавление по зарезервированному месту.
Процедура ЗаписатьКонтейнер(Поток, Файлы, ПараметрыЗаписи, Паковать, ВыравниватьОглавление = Истина)

	ЗаписатьЗаголовокКонтейнера(Поток, ПараметрыЗаписи, Файлы);

	КоличествоПолейАдресации = 3;
	РазмерОглавления = Файлы.Количество() * ПараметрыЗаписи.РазмерПоляАдресации * КоличествоПолейАдресации;
	ПозицияОглавления = ЗарезервироватьМестоОглавления(Поток, ПараметрыЗаписи, РазмерОглавления, ВыравниватьОглавление);

	Оглавление = Новый БуферДвоичныхДанных(РазмерОглавления, ПорядокБайтов.LittleEndian);
	ПотокОглавления = Новый ПотокВПамяти(Оглавление);
	ЗаписьОглавления = Новый ЗаписьДанных(ПотокОглавления);

	Для Каждого Файл Из Файлы Цикл

		АдресДокументов = ЗаписатьФайлКонтейнера(Поток, Файл, ПараметрыЗаписи, Паковать);

		ЗаписьОглавления.ЗаписатьЦелое32(АдресДокументов.АдресАтрибутов);
		ЗаписьОглавления.ЗаписатьЦелое32(АдресДокументов.АдресДанных);
		ЗаписьОглавления.ЗаписатьБуферДвоичныхДанных(ПараметрыЗаписи.РазделительОглавления);

	КонецЦикла;

	ЗаписьОглавления.Закрыть();
	ПотокОглавления.Закрыть();

	Поток.Перейти(ПозицияОглавления, ПозицияВПотоке.Начало);
	ЗаписатьДокументКонтейнера(Поток, Оглавление, ПараметрыЗаписи, Ложь, ВыравниватьОглавление);

КонецПроцедуры

// Записывает 16-байтный заголовок контейнера.
Процедура ЗаписатьЗаголовокКонтейнера(Поток, ПараметрыЗаписи, Файлы)

	Запись = Новый ЗаписьДанных(Поток, , ПорядокБайтов.LittleEndian);
	Запись.ЗаписатьЦелое32(ПараметрыЗаписи.МаксимальноеЦелоеЧисло);
	Запись.ЗаписатьЦелое32(ПараметрыЗаписи.РазмерБлокаСодержимого); // размер блока по умолчанию
	Запись.ЗаписатьЦелое32(Файлы.Количество());
	Запись.ЗаписатьЦелое32(0);
	Запись.Закрыть();

КонецПроцедуры

// Резервирует место под оглавление и возвращает его позицию.
//
// Возвращаемое значение:
//  Число - Позиция оглавления в потоке.
Функция ЗарезервироватьМестоОглавления(Поток, ПараметрыЗаписи, РазмерОглавления, ВыравниватьОглавление)

	ПозицияОглавления = Поток.ТекущаяПозиция();
	Если ВыравниватьОглавление Тогда
		РезервируемыйРазмер = Макс(РазмерОглавления, ПараметрыЗаписи.РазмерБлокаСодержимого) + ПараметрыЗаписи.РазмерЗаголовкаБлока;
	Иначе
		РезервируемыйРазмер = РазмерОглавления + ПараметрыЗаписи.РазмерЗаголовкаБлока;
	КонецЕсли;

	Поток.Записать(Новый БуферДвоичныхДанных(РезервируемыйРазмер, ПорядокБайтов.LittleEndian), 0, РезервируемыйРазмер); // Резервирование под оглавление

	Возврат ПозицияОглавления;

КонецФункции

// Записывает один файл контейнера: атрибуты (имя, даты) и данные.
//
// Возвращаемое значение:
//  Структура - Поля АдресАтрибутов, АдресДанных.
Функция ЗаписатьФайлКонтейнера(Поток, ОписаниеФайла, ПараметрыЗаписи, Паковать)

	Если ОписаниеФайла.ЭтоКонтейнер Тогда
		ПотокКонтейнера = Новый ПотокВПамяти();
		ЗаписатьКонтейнер(ПотокКонтейнера, ОписаниеФайла.Данные, ПараметрыЗаписи, Ложь, Ложь);
		ДанныеФайла = ПотокКонтейнера.ЗакрытьИПолучитьДвоичныеДанные();
	Иначе
		ДанныеФайла = ОписаниеФайла.Данные;
	КонецЕсли;

	АтрибутыФайла = АтрибутыФайлаКонтейнера(ОписаниеФайла.ИмяФайла);

	АдресАтрибутов = ЗаписатьДокументКонтейнера(Поток, АтрибутыФайла, ПараметрыЗаписи, Ложь, Ложь);
	АдресДанных = ЗаписатьДокументКонтейнера(Поток, ДанныеФайла, ПараметрыЗаписи, Паковать, Истина);

	Возврат Новый Структура("АдресАтрибутов, АдресДанных", АдресАтрибутов, АдресДанных);

КонецФункции

// Формирует блок атрибутов файла: две даты int64, резерв int32, имя UTF16.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Атрибуты файла.
Функция АтрибутыФайлаКонтейнера(ИмяФайла)

	БуферИмениФайла = ПолучитьБуферДвоичныхДанныхИзСтроки(ИмяФайла, КодировкаТекста.UTF16);

	// BSLLS:MagicNumber-off
	БуферАтрибутов = Новый БуферДвоичныхДанных(БуферИмениФайла.Размер + 24);
	БуферАтрибутов.ЗаписатьЦелое64(0, ДатаЧислом(ТекущаяУниверсальнаяДата()));
	БуферАтрибутов.ЗаписатьЦелое64(8, ДатаЧислом(ТекущаяУниверсальнаяДата()));
	БуферАтрибутов.ЗаписатьЦелое32(16, 0);
	БуферАтрибутов.Записать(20, БуферИмениФайла);
	// BSLLS:MagicNumber-on

	Возврат БуферАтрибутов;

КонецФункции

// Записывает документ (байты/бинарные данные) блоками с заголовком.
//
// Возвращаемое значение:
//  Число - Адрес документа в потоке.
Функция ЗаписатьДокументКонтейнера(ПотокЗаписи, ИсточникДанных, ПараметрыЗаписи, Паковать = Ложь, Выравнивать = Истина)

	Позиция = ПотокЗаписи.ТекущаяПозиция();

	Если ТипЗнч(ИсточникДанных) = Тип("БуферДвоичныхДанных") Тогда
		ДанныеДокумента = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ИсточникДанных);
	ИначеЕсли Паковать Тогда
		ДанныеДокумента = СжатьДвоичныеДанныеКонтейнера(ИсточникДанных);
	Иначе
		ДанныеДокумента = ИсточникДанных;
	КонецЕсли;

	РазмерДанных = ДанныеДокумента.Размер();
	РазмерБлока = ?(Не Выравнивать, РазмерДанных, Макс(ПараметрыЗаписи.РазмерБлокаСодержимого, РазмерДанных));

	ЗаписьДокумента = Новый ЗаписьДанных(ПотокЗаписи);

	ЗаписатьЗаголовокБлокаКонтейнера(ЗаписьДокумента, ПараметрыЗаписи, РазмерДанных, РазмерБлока);
	ЗаписьДокумента.Записать(ДанныеДокумента);

	ТребуетсяДописать = РазмерБлока - РазмерДанных;

	Если Выравнивать И ТребуетсяДописать > 0 Тогда
		ЗаписьДокумента.ЗаписатьБуферДвоичныхДанных(Новый БуферДвоичныхДанных(ТребуетсяДописать));
	КонецЕсли;

	ЗаписьДокумента.Закрыть();

	Возврат Позиция;

КонецФункции

// Записывает заголовок блока контейнера: 0D 0A, размеры, адрес последнего блока.
Процедура ЗаписатьЗаголовокБлокаКонтейнера(Запись, ПараметрыЗаписи, Размер, РазмерБлока)

	ВозвратКаретки = 13;
	ПереносСтроки = 10;
	Пробел = 32;

	Запись.ЗаписатьБайт(ВозвратКаретки);
	Запись.ЗаписатьБайт(ПереносСтроки);
	Запись.ЗаписатьБуферДвоичныхДанных(БайтыИзЧислаКонтейнера(Размер, ПараметрыЗаписи.РазмерПоляАдресации));
	Запись.ЗаписатьБайт(Пробел);
	Запись.ЗаписатьБуферДвоичныхДанных(БайтыИзЧислаКонтейнера(РазмерБлока, ПараметрыЗаписи.РазмерПоляАдресации));
	Запись.ЗаписатьБайт(Пробел);
	Запись.ЗаписатьБуферДвоичныхДанных(ПараметрыЗаписи.АдресПоследнегоБлока);
	Запись.ЗаписатьБайт(Пробел);
	Запись.ЗаписатьБайт(ВозвратКаретки);
	Запись.ЗаписатьБайт(ПереносСтроки);

КонецПроцедуры

// Кодирует число hex-строкой BigEndian фиксированного размера.
//
// Возвращаемое значение:
//  БуферДвоичныхДанных - Байты числа.
Функция БайтыИзЧислаКонтейнера(Число, Размер)

	Буфер = Новый БуферДвоичныхДанных(Размер);
	Буфер.ЗаписатьЦелое32(0, Число, ПорядокБайтов.BigEndian);

	Hex = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Буфер);

	Возврат ПолучитьБуферДвоичныхДанныхИзСтроки(НРег(Hex));

КонецФункции

// Переводит дату в число 100-микросекундных интервалов с начала нашей эры.
//
// Возвращаемое значение:
//  Число - Дата числом.
Функция ДатаЧислом(ДатаВремя)

	Множитель = 10000; // Количество 100-микросекундных интервалов с 01.01.0001 00:00:00

	Возврат (ДатаВремя - '00010101') * Множитель;

КонецФункции

// Сжимает данные deflate через временный файл и zip-архив.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Сжатые данные.
Функция СжатьДвоичныеДанныеКонтейнера(ДвоичныеДанные)

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	СжатыйФайл = СжатьФайлКонтейнера(ИмяВременногоФайла);
	УдалитьФайлы(ИмяВременногоФайла); // BSLLS:UsingSynchronousCalls-off

	Возврат СжатыйФайл;

КонецФункции

// Сжимает файл deflate и извлекает сжатые данные из zip-контейнера.
//
// Возвращаемое значение:
//  ДвоичныеДанные - Сжатые данные файла.
Функция СжатьФайлКонтейнера(ИмяФайлаДляСжатия)

	ПотокДанных = Новый ПотокВПамяти;

	ЗаписьZip = Новый ЗаписьZipФайла(ПотокДанных, , , МетодСжатияZIP.Сжатие, УровеньСжатияZIP.Оптимальный);
	ЗаписьZip.Добавить(ИмяФайлаДляСжатия);
	ЗаписьZip.Записать();

	// BSLLS:MagicNumber-off
	ПотокДанных.Перейти(18, ПозицияВПотоке.Начало);

	Буфер = Новый БуферДвоичныхДанных(12, ПорядокБайтов.LittleEndian);
	ПотокДанных.Прочитать(Буфер, 0, 12);
	РазмерСжатыхДанных = Буфер.ПрочитатьЦелое32(0);
	РазмерИмениФайла = Буфер.ПрочитатьЦелое16(8);
	РазмерИмениДоп = Буфер.ПрочитатьЦелое16(10);
	// BSLLS:MagicNumber-on

	ПотокДанных.Перейти(РазмерИмениФайла + РазмерИмениДоп, ПозицияВПотоке.Текущая);

	БуферСжатыеДанные = Новый БуферДвоичныхДанных(РазмерСжатыхДанных);
	ПотокДанных.Прочитать(БуферСжатыеДанные, 0, РазмерСжатыхДанных);
	ПотокДанных.Закрыть();

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферСжатыеДанные);

КонецФункции

#Область РаботаСФайламиКонтейнера

// Находит файл в контейнере по пути с разделителем "/"; вложенные уровни - контейнеры.
//
// Параметры:
//  Оглавление - Массив из Структура - Записи оглавления контейнера.
//  ПолноеИмяФайла - Строка - Полное имя файла, разделитель пути - "/".
//
// Возвращаемое значение:
//  Структура - Запись оглавления файла.
Функция НайтиФайлКонтейнера(Оглавление, ПолноеИмяФайла)

	Путь = СтрРазделить(ПолноеИмяФайла, "/");

	Файлы = Оглавление;
	НайденныйФайл = Неопределено;
	Для Инд = 0 По Путь.ВГраница() Цикл

		НайденныйФайл = Неопределено;
		Для Каждого Файл Из Файлы Цикл
			Если СтрСравнить(Файл.ИмяФайла, Путь[Инд]) = 0 Тогда
				НайденныйФайл = Файл;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если НайденныйФайл = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Не удалось найти файл %1 в контейнере обработки", ПолноеИмяФайла);
		КонецЕсли;

		Если Инд < Путь.ВГраница() Тогда
			Если НЕ НайденныйФайл.ЭтоКонтейнер Тогда
				ВызватьИсключение СтрШаблон("Файл %1 должен быть контейнером", Путь[Инд]);
			КонецЕсли;
			Файлы = НайденныйФайл.Данные;
		КонецЕсли;
	КонецЦикла;

	Возврат НайденныйФайл;

КонецФункции

// Устанавливает текст файла контейнера (в кодировке UTF-8 без BOM).
//
// Параметры:
//  Оглавление - Массив из Структура - Записи оглавления контейнера.
//  ПолноеИмяФайла - Строка - Полное имя файла, разделитель пути - "/".
//  Текст - Строка - Новый текст файла.
Процедура УстановитьТекстФайлаКонтейнера(Оглавление, ПолноеИмяФайла, Текст)

	Файл = НайтиФайлКонтейнера(Оглавление, ПолноеИмяФайла);
	Если Файл.ЭтоКонтейнер Тогда
		ВызватьИсключение СтрШаблон("Файл %1 это контейнер, а должен быть обычным файлом", ПолноеИмяФайла);
	КонецЕсли;

	Файл.Данные = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);

КонецПроцедуры

// Формирует пустую запись оглавления контейнера.
//
// Возвращаемое значение:
//  Структура - Поля АдресЗаголовкаФайла, АдресТелаФайла, ИмяФайла, ЭтоКонтейнер, Данные.
Функция ЗаписьОглавленияКонтейнера()

	Запись = Новый Структура;
	Запись.Вставить("АдресЗаголовкаФайла", 0);
	Запись.Вставить("АдресТелаФайла", 0);
	Запись.Вставить("ИмяФайла", "");
	Запись.Вставить("ЭтоКонтейнер", Ложь);
	Запись.Вставить("Данные", Неопределено);

	Возврат Запись;

КонецФункции

// Формирует структуру параметров формата контейнера внешней обработки.
//
// Возвращаемое значение:
//  Структура - Параметры формата.
Функция ПараметрыЗаписиКонтейнера()

	// BSLLS:MagicNumber-off
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("РазмерЗаголовкаКонтейнера", 16);
	ПараметрыЗаписи.Вставить("РазмерЗаголовкаБлока", 31);
	ПараметрыЗаписи.Вставить("РазмерПоляАдресации", 4);
	ПараметрыЗаписи.Вставить("РазделительОглавления", ПолучитьБуферДвоичныхДанныхИзHexСтроки("FFFFFF7F"));
	ПараметрыЗаписи.Вставить("Смещение", 0);
	ПараметрыЗаписи.Вставить("МаксимальноеЦелоеЧисло", 2147483647);
	ПараметрыЗаписи.Вставить("РазмерБлокаОглавления", 512);
	ПараметрыЗаписи.Вставить("РазмерБлокаСодержимого", 512);
	ПараметрыЗаписи.Вставить("АдресПоследнегоБлока", ПолучитьБуферДвоичныхДанныхИзHexСтроки("3766666666666666"));
	// BSLLS:MagicNumber-on

	Возврат ПараметрыЗаписи;

КонецФункции

#КонецОбласти

#КонецОбласти

#КонецОбласти
