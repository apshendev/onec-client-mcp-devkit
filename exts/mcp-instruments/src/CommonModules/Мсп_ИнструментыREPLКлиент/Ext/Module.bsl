#Область ПрограммныйИнтерфейс

// Создаёт новый REPL-сеанс без MCP-обвязки (программный доступ, используется тестами).
//
// Возвращаемое значение:
//  Строка - Идентификатор сеанса (адрес временного хранилища со Состоянием).
Функция СоздатьСеанс() Экспорт

	Возврат Мсп_ИнструментыREPLСервер.СоздатьСеанс();

КонецФункции

// Исполняет фрагмент BSL в сеансе REPL без MCP-обвязки (программный доступ).
//
// Параметры:
//  Адрес - Строка - Идентификатор сеанса из СоздатьСеанс.
//  Код - Строка - Фрагмент BSL.
//  ИмяМетода - Строка, Неопределено - Имя метода для вызова (только module-фрагменты).
//  Аргументы - Структура, Неопределено - Аргументы вызова метода.
//
// Возвращаемое значение:
//  Структура - Structured-ответ REPL (см. docs/specs/repl.md).
Функция Исполнить(Знач Адрес, Знач Код, Знач ИмяМетода = Неопределено, Знач Аргументы = Неопределено) Экспорт

	Возврат Мсп_ИнструментыREPLСервер.Исполнить(Адрес, Код, ИмяМетода, Аргументы);

КонецФункции

// Закрывает REPL-сеанс без MCP-обвязки (программный доступ). Идемпотентен.
//
// Параметры:
//  Адрес - Строка - Идентификатор сеанса.
//
// Возвращаемое значение:
//  Булево - Истина, если сеанс существовал и закрыт.
Функция ЗакрытьСеанс(Знач Адрес) Экспорт

	Возврат Мсп_ИнструментыREPLСервер.ЗакрытьСеанс(Адрес);

КонецФункции

// Регистрирует инструменты провайдера REPL.
//
// Параметры:
//  ИсточникРегистрации - Произвольный - Источник регистрации провайдера.
Процедура Зарегистрировать(ИсточникРегистрации) Экспорт
	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"repl_create",
		ОписаниеИнструментаСозданияСеанса(),
		СхемаИнструментаСозданияСеанса(),
		Новый ОписаниеОповещения("ОбработатьИнструментСозданияСеанса", Мсп_ИнструментыREPLКлиент)),
		ИсточникРегистрации);

	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"repl_eval",
		ОписаниеИнструментаИсполнения(),
		СхемаИнструментаИсполнения(),
		Новый ОписаниеОповещения("ОбработатьИнструментИсполнения", Мсп_ИнструментыREPLКлиент)),
		ИсточникРегистрации);

	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"repl_close",
		ОписаниеИнструментаЗакрытияСеанса(),
		СхемаИнструментаЗакрытияСеанса(),
		Новый ОписаниеОповещения("ОбработатьИнструментЗакрытияСеанса", Мсп_ИнструментыREPLКлиент)),
		ИсточникРегистрации);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает вызов repl_create.
//
// Параметры:
//  Запрос - Структура - Запрос инструмента:
//   * Аргументы - Структура - Аргументы вызова (нет).
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры вызова.
//
// Возвращаемое значение:
//  Структура - Результат вызова инструмента.
Функция ОбработатьИнструментСозданияСеанса(Запрос, ДополнительныеПараметры) Экспорт
	Попытка
		Идентификатор = Мсп_ИнструментыREPLСервер.СоздатьСеанс();

		Возврат Мсп_Результаты.JSON(Новый Структура("repl_id", Идентификатор));
	Исключение
		Возврат ОтветСОшибкойREPL("internal_error", ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Обрабатывает вызов repl_eval.
//
// Параметры:
//  Запрос - Структура - Запрос инструмента:
//   * Аргументы - Структура - Аргументы вызова: repl_id, code, method, arguments.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры вызова.
//
// Возвращаемое значение:
//  Структура - Результат вызова инструмента.
Функция ОбработатьИнструментИсполнения(Запрос, ДополнительныеПараметры) Экспорт
	Попытка
		Идентификатор = "";
		Если Не СтроковыйАргумент(Запрос.Аргументы, "repl_id", Идентификатор) Тогда
			Возврат ОтветИнвалидныйАргумент("repl_id must be a non-empty string");
		КонецЕсли;

		Код = "";
		Если Не СтроковыйАргумент(Запрос.Аргументы, "code", Код) Тогда
			Возврат ОтветИнвалидныйАргумент("code must be a non-empty string");
		КонецЕсли;

		ИмяМетода = Неопределено;
		Если Запрос.Аргументы.Свойство("method", ИмяМетода) И ИмяМетода <> Неопределено Тогда
			Если ТипЗнч(ИмяМетода) <> Тип("Строка") Тогда
				Возврат ОтветИнвалидныйАргумент("method must be a string");
			КонецЕсли;
		КонецЕсли;

		АргументыВызова = Неопределено;
		Если Запрос.Аргументы.Свойство("arguments", АргументыВызова)
			И АргументыВызова <> Неопределено Тогда
			Если ТипЗнч(АргументыВызова) <> Тип("Структура") Тогда
				Возврат ОтветИнвалидныйАргумент("arguments must be an object");
			КонецЕсли;
		КонецЕсли;

		Возврат Мсп_Результаты.JSON(
			Мсп_ИнструментыREPLСервер.Исполнить(Идентификатор, Код, ИмяМетода, АргументыВызова));
	Исключение
		Возврат ОтветСОшибкойREPL("internal_error", ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Обрабатывает вызов repl_close.
//
// Параметры:
//  Запрос - Структура - Запрос инструмента:
//   * Аргументы - Структура - Аргументы вызова: repl_id.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры вызова.
//
// Возвращаемое значение:
//  Структура - Результат вызова инструмента.
Функция ОбработатьИнструментЗакрытияСеанса(Запрос, ДополнительныеПараметры) Экспорт
	Попытка
		Идентификатор = "";
		Если Не СтроковыйАргумент(Запрос.Аргументы, "repl_id", Идентификатор) Тогда
			Возврат ОтветИнвалидныйАргумент("repl_id must be a non-empty string");
		КонецЕсли;

		Закрыт = Мсп_ИнструментыREPLСервер.ЗакрытьСеанс(Идентификатор);

		Возврат Мсп_Результаты.JSON(Новый Структура("repl_id, closed", Идентификатор, Закрыт));
	Исключение
		Возврат ОтветСОшибкойREPL("internal_error", ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Формирует описание инструмента repl_create.
//
// Возвращаемое значение:
//  Строка - Описание инструмента.
Функция ОписаниеИнструментаСозданияСеанса()
	Возврат "Создаёт новый сеанс REPL 1C и возвращает его идентификатор repl_id. "
		+ "Сеанс помнит между вызовами только значения, положенные в Состояние (Соответствие). "
		+ "«Сбросить всё» — repl_close и новый repl_create.";
КонецФункции

// Формирует описание инструмента repl_eval.
//
// Возвращаемое значение:
//  Строка - Описание инструмента.
Функция ОписаниеИнструментаИсполнения()
	Возврат "Исполняет фрагмент BSL в живой информационной базе: выражение (возвращается значение), "
		+ "операторы (значение — через переменную Результат) или текст модуля с подпрограммами "
		+ "(компиляция во внешнюю обработку, опциональный вызов method с arguments). "
		+ "НИЧЕГО не сохраняется: каждый вызов исполняется в транзакции с безусловным откатом, "
		+ "база не меняется никогда. Возвращайте значения выражением или через Результат, "
		+ "а не Сообщить — вывод Сообщить не захватывается. Управление транзакциями "
		+ "(НачатьТранзакцию и т.п.) вырезается из фрагмента.";
КонецФункции

// Формирует описание инструмента repl_close.
//
// Возвращаемое значение:
//  Строка - Описание инструмента.
Функция ОписаниеИнструментаЗакрытияСеанса()
	Возврат "Закрывает сеанс REPL. Идемпотентен: закрытие уже закрытого сеанса "
		+ "возвращает closed=false, а не ошибку.";
КонецФункции

// Формирует схему параметров инструмента repl_create.
//
// Возвращаемое значение:
//  Структура - Схема параметров.
Функция СхемаИнструментаСозданияСеанса()
	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Новый Структура, Новый Массив);
КонецФункции

// Формирует схему параметров инструмента repl_eval.
//
// Возвращаемое значение:
//  Структура - Схема параметров.
Функция СхемаИнструментаИсполнения()
	Свойства = Новый Структура;
	Свойства.Вставить("repl_id", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Идентификатор сеанса из repl_create"));
	Свойства.Вставить("code", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Фрагмент BSL: выражение, операторы или текст модуля с подпрограммами"));
	Свойства.Вставить("method", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Имя экспортного метода для вызова после компиляции (только для фрагментов-модулей)"));
	Свойства.Вставить("arguments", Мсп_СхемаПараметров.НовыйСвойствоСхемы("object",
		"Аргументы вызова method по имени; ключи обязаны совпадать с параметрами метода"));

	Требуемые = Новый Массив;
	Требуемые.Добавить("repl_id");
	Требуемые.Добавить("code");

	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Свойства, Требуемые);
КонецФункции

// Формирует схему параметров инструмента repl_close.
//
// Возвращаемое значение:
//  Структура - Схема параметров.
Функция СхемаИнструментаЗакрытияСеанса()
	Свойства = Новый Структура;
	Свойства.Вставить("repl_id", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Идентификатор сеанса"));

	Требуемые = Новый Массив;
	Требуемые.Добавить("repl_id");

	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Свойства, Требуемые);
КонецФункции

// Формирует structured-ответ REPL с ошибкой вида internal_error.
//
// Параметры:
//  Вид - Строка - Код ошибки (error.kind).
//  Сообщение - Строка - Текст ошибки (error.message).
//
// Возвращаемое значение:
//  Структура - Результат вызова инструмента.
Функция ОтветСОшибкойREPL(Вид, Сообщение)
	Ответ = Новый Структура;
	Ответ.Вставить("status", "error");
	Ответ.Вставить("mode", "");
	Ответ.Вставить("error", Новый Структура("kind, message", Вид, Сообщение));
	Ответ.Вставить("rolled_back", Ложь);
	Ответ.Вставить("duration_ms", 0);

	Возврат Мсп_Результаты.JSON(Ответ);
КонецФункции

// Формирует structured-ответ REPL с ошибкой invalid_argument.
//
// Параметры:
//  Сообщение - Строка - Текст ошибки.
//
// Возвращаемое значение:
//  Структура - Результат вызова инструмента.
Функция ОтветИнвалидныйАргумент(Сообщение)
	Возврат ОтветСОшибкойREPL("invalid_argument", Сообщение);
КонецФункции

// Проверяет наличие непустого строкового аргумента.
//
// Параметры:
//  Аргументы - Структура - Аргументы вызова.
//  Имя - Строка - Имя аргумента.
//  Значение - Строка - Найденное значение аргумента.
//
// Возвращаемое значение:
//  Булево - Истина, если аргумент есть и непуст.
Функция СтроковыйАргумент(Аргументы, Имя, Значение)
	Если Не Аргументы.Свойство(Имя, Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

#КонецОбласти
