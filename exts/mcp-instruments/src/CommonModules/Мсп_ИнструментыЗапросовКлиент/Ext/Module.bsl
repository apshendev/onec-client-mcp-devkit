// Формирует описание инструмента execute_query.
//
// Возвращаемое значение:
//  Строка - Описание инструмента.
Функция ОписаниеИнструментаВыполненияЗапроса()
	Возврат "Выполнить запрос на языке 1С (ВЫБРАТЬ/SELECT) и получить данные из базы: список элементов справочника, "
		+ "документы за период, остатки, обороты, сведения из регистров. Используй когда нужно найти, посчитать "
		+ "или вывести конкретные данные. Поддерживает параметры через &Имя. "
		+ "Имена таблиц: Справочник.X, Документ.X, РегистрНакопления.X, РегистрСведений.X (единственное число, "
		+ "НЕ Справочники/Документы). Перечисления НЕ являются таблицами: используй "
		+ "ЗНАЧЕНИЕ(Перечисление.Имя.Значение) в WHERE/CASE. "
		+ "Виртуальные таблицы регистров: РегистрНакопления.X.Остатки(&Период), "
		+ ".Обороты(&НачалоПериода, &КонецПериода), РегистрСведений.X.СрезПоследних(&Период). "
		+ "Перед выполнением вызови validate_query для проверки синтаксиса. "
		+ "Имена полей бери из get_object_structure.";
КонецФункции

// Формирует описание инструмента validate_query.
//
// Возвращаемое значение:
//  Строка - Описание инструмента.
Функция ОписаниеИнструментаПроверкиЗапроса()
	Возврат "Проверить синтаксис запроса 1С без выполнения, найдёт ошибки в ВЫБРАТЬ/SELECT. "
		+ "Всегда вызывай перед execute_query для проверки синтаксиса запроса.";
КонецФункции

// Формирует схему параметров инструмента execute_query.
//
// Возвращаемое значение:
//  Структура - Схема параметров.
Функция СхемаИнструментаВыполненияЗапроса()
	Свойства = Новый Структура;
	Свойства.Вставить("query", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Текст запроса на языке запросов 1С. Только ВЫБРАТЬ/SELECT. Параметры указывай через &ИмяПараметра."));
	Свойства.Вставить("limit", Мсп_СхемаПараметров.НовыйСвойствоСхемы("integer",
		"Максимальное количество строк результата (по умолчанию 100, максимум 1000)"));
	Свойства.Вставить("parameters", Мсп_СхемаПараметров.НовыйСвойствоСхемы("object",
		"Параметры запроса в виде пар ключ-значение. Ключ — имя параметра без амперсанда. "
		+ "Пример: {""Контрагент"": ""ООО Ромашка"", ""ДатаНачала"": ""2026-01-01""}"));

	Требуемые = Новый Массив;
	Требуемые.Добавить("query");

	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Свойства, Требуемые);
КонецФункции

// Формирует схему параметров инструмента validate_query.
//
// Возвращаемое значение:
//  Структура - Схема параметров.
Функция СхемаИнструментаПроверкиЗапроса()
	Свойства = Новый Структура;
	Свойства.Вставить("query", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Текст запроса на языке запросов 1С для проверки"));

	Требуемые = Новый Массив;
	Требуемые.Добавить("query");

	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Свойства, Требуемые);
КонецФункции

// Проверяет наличие непустого строкового аргумента.
//
// Параметры:
//  Аргументы - Структура - Аргументы вызова.
//  Имя - Строка - Имя аргумента.
//  Значение - Строка - Найденное значение аргумента.
//
// Возвращаемое значение:
//  Булево - Истина, если аргумент есть и непуст.
Функция СтроковыйАргумент(Аргументы, Имя, Значение)
	Если Не Аргументы.Свойство(Имя, Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Формирует ошибку отсутствия обязательного аргумента.
//
// Параметры:
//  Имя - Строка - Имя аргумента.
//
// Возвращаемое значение:
//  Структура - Ошибка инструмента.
Функция ОшибкаОтсутствующегоАргумента(Имя)
	Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS",
		СтрШаблон("missing required argument ""%1""", Имя));
КонецФункции

// Преобразует исключение серверного модуля в ошибку инструмента.
//
// Параметры:
//  ТекстОшибки - Строка - Описание исключения.
//
// Возвращаемое значение:
//  Структура - Ошибка инструмента.
Функция ОшибкаСервера(ТекстОшибки)
	Если СтрНайти(ТекстОшибки, "Object not found") > 0 Или СтрНайти(ТекстОшибки, "Form not found") > 0 Тогда
		Возврат Мсп_Сервер.ОшибкаИнструмента("NOT_FOUND", ТекстОшибки);
	КонецЕсли;
	Если СтрНайти(ТекстОшибки, "reading the event log requires") > 0 Тогда
		Возврат Мсп_Сервер.ОшибкаИнструмента("ACTION_DENIED", ТекстОшибки);
	КонецЕсли;
	Возврат Мсп_Сервер.ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
КонецФункции

#КонецОбласти
