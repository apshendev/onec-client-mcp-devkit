#Область ПрограммныйИнтерфейс

// Регистрирует инструменты и промпты провайдера запросов.
Процедура Зарегистрировать(ИсточникРегистрации) Экспорт
	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"execute_query",
		ОписаниеИнструментаВыполненияЗапроса(),
		СхемаИнструментаВыполненияЗапроса(),
		Новый ОписаниеОповещения("ОбработатьИнструментВыполненияЗапроса", Мсп_ИнструментыЗапросовКлиент)),
		ИсточникРегистрации);

	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"validate_query",
		ОписаниеИнструментаПроверкиЗапроса(),
		СхемаИнструментаПроверкиЗапроса(),
		Новый ОписаниеОповещения("ОбработатьИнструментПроверкиЗапроса", Мсп_ИнструментыЗапросовКлиент)),
		ИсточникРегистрации);

	ЗарегистрироватьПромптОптимизацииЗапроса(ИсточникРегистрации);
	ЗарегистрироватьПромптСинтаксисаЗапросов(ИсточникРегистрации);
	ЗарегистрироватьПромптНаписанияОтчёта(ИсточникРегистрации);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает вызов execute_query.
//
// Параметры:
//  Запрос - Структура - Запрос инструмента:
//   * Аргументы - Структура - Аргументы вызова: query, limit, parameters.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры вызова.
//
// Возвращаемое значение:
//  Структура - Результат вызова инструмента.
Функция ОбработатьИнструментВыполненияЗапроса(Запрос, ДополнительныеПараметры) Экспорт
	Попытка
		ТекстЗапроса = "";
		Если Не СтроковыйАргумент(Запрос.Аргументы, "query", ТекстЗапроса) Тогда
			Возврат ОшибкаОтсутствующегоАргумента("query");
		КонецЕсли;

		Лимит = Неопределено;
		Если Запрос.Аргументы.Свойство("limit", Лимит) И Лимит <> Неопределено Тогда
			Если ТипЗнч(Лимит) <> Тип("Число") Тогда
				Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS", "limit must be a number");
			КонецЕсли;
		КонецЕсли;

		ПараметрыЗапроса = Неопределено;
		Если Запрос.Аргументы.Свойство("parameters", ПараметрыЗапроса)
			И ПараметрыЗапроса <> Неопределено Тогда
			Если ТипЗнч(ПараметрыЗапроса) <> Тип("Структура") Тогда
				Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS", "parameters must be an object");
			КонецЕсли;
		КонецЕсли;

		Возврат Мсп_Результаты.JSON(
			Мсп_ИнструментыЗапросовСервер.ВыполнитьЗапрос(ТекстЗапроса, Лимит, ПараметрыЗапроса));
	Исключение
		Возврат ОшибкаСервера(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Обрабатывает вызов validate_query.
//
// Параметры:
//  Запрос - Структура - Запрос инструмента:
//   * Аргументы - Структура - Аргументы вызова: query.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры вызова.
//
// Возвращаемое значение:
//  Структура - Результат вызова инструмента.
Функция ОбработатьИнструментПроверкиЗапроса(Запрос, ДополнительныеПараметры) Экспорт
	Попытка
		ТекстЗапроса = "";
		Если Не СтроковыйАргумент(Запрос.Аргументы, "query", ТекстЗапроса) Тогда
			Возврат ОшибкаОтсутствующегоАргумента("query");
		КонецЕсли;

		Возврат Мсп_Результаты.JSON(Мсп_ИнструментыЗапросовСервер.ПроверитьЗапрос(ТекстЗапроса));
	Исключение
		Возврат ОшибкаСервера(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Регистрирует промпт optimize_query.
//
// Параметры:
//  ИсточникРегистрации - Произвольный - Источник регистрации провайдера.
Процедура ЗарегистрироватьПромптОптимизацииЗапроса(ИсточникРегистрации)
	Аргументы = Новый Массив;
	Аргументы.Добавить(Новый Структура("name,description,required",
		"query", "Текст запроса на языке 1С", Истина));

	Мсп_Сервер.ЗарегистрироватьПромпт(Мсп_Сервер.НовыйПромпт(
		"optimize_query",
		"Оптимизация запроса 1С",
		Аргументы,
		Новый ОписаниеОповещения("ОбработатьПромптОптимизацииЗапроса", Мсп_ИнструментыЗапросовКлиент)),
		ИсточникРегистрации);
КонецПроцедуры

// Регистрирует промпт 1c_query_syntax.
//
// Параметры:
//  ИсточникРегистрации - Произвольный - Источник регистрации провайдера.
Процедура ЗарегистрироватьПромптСинтаксисаЗапросов(ИсточникРегистрации)
