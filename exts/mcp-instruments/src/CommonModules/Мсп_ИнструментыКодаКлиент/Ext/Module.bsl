#Область ПрограммныйИнтерфейс

// Регистрирует инструменты и промпты провайдера кода.
Процедура Зарегистрировать(ИсточникРегистрации) Экспорт
	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"validate_bsl_code",
		ОписаниеИнструментаПроверкиКода(),
		СхемаИнструментаПроверкиКода(),
		Новый ОписаниеОповещения("ОбработатьИнструментПроверкиКода", Мсп_ИнструментыКодаКлиент)),
		ИсточникРегистрации);

	ЗарегистрироватьПромптРевьюМодуля(ИсточникРегистрации);
	ЗарегистрироватьПромптПроведенияДокумента(ИсточникРегистрации);
	ЗарегистрироватьПромптПоискаДублей(ИсточникРегистрации);
	ЗарегистрироватьПромптРабочегоПроцесса(ИсточникРегистрации);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает вызов validate_bsl_code.
//
// Параметры:
//  Запрос - Структура - Запрос инструмента:
//   * Аргументы - Структура - Аргументы вызова: mode, code, arguments, allow_changes, confirm.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры вызова.
//
// Возвращаемое значение:
//  Структура - Результат вызова инструмента.
Функция ОбработатьИнструментПроверкиКода(Запрос, ДополнительныеПараметры) Экспорт
	Попытка
		Режим = "";
		Если Не СтроковыйАргумент(Запрос.Аргументы, "mode", Режим) Тогда
			Возврат ОшибкаОтсутствующегоАргумента("mode");
		КонецЕсли;

		Код = "";
		Если Не СтроковыйАргумент(Запрос.Аргументы, "code", Код) Тогда
			Возврат ОшибкаОтсутствующегоАргумента("code");
		КонецЕсли;

		АргументыВызова = Неопределено;
		Если Запрос.Аргументы.Свойство("arguments", АргументыВызова)
			И АргументыВызова <> Неопределено Тогда
			Если ТипЗнч(АргументыВызова) <> Тип("Структура") Тогда
				Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS", "arguments must be an object");
			КонецЕсли;
		КонецЕсли;

		РазрешитьИзменения = Ложь;
		Запрос.Аргументы.Свойство("allow_changes", РазрешитьИзменения);

		Подтверждение = Ложь;
		Запрос.Аргументы.Свойство("confirm", Подтверждение);

		Возврат Мсп_Результаты.JSON(
			Мсп_ИнструментыКодаСервер.ПроверитьКод(Режим, Код, АргументыВызова, РазрешитьИзменения, Подтверждение));
	Исключение
		Возврат ОшибкаСервера(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Регистрирует промпт review_module.
