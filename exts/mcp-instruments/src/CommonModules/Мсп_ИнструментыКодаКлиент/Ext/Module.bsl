	Строки.Добавить("");
	Строки.Добавить("""И"" является логическим оператором (AND), использовать его как переменную нельзя.");
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Формирует описание инструмента validate_bsl_code.
//
// Возвращаемое значение:
//  Строка - Описание инструмента.
Функция ОписаниеИнструментаПроверкиКода()
	Возврат "Скомпилировать или безопасно исполнить серверную функцию/процедуру BSL в текущей ИБ. "
		+ "Режим compile только проверяет синтаксис; режим execute вызывает метод внутри транзакции, "
		+ "которая откатывается по умолчанию. Всегда вызывай перед попыткой записать сгенерированный код "
		+ "в конфигурацию.";
КонецФункции

// Формирует схему параметров инструмента validate_bsl_code.
//
// Возвращаемое значение:
//  Структура - Схема параметров.
Функция СхемаИнструментаПроверкиКода()
	ДопустимыеРежимы = Новый Массив;
	ДопустимыеРежимы.Добавить("compile");
	ДопустимыеРежимы.Добавить("execute");

	Свойства = Новый Структура;
	Свойства.Вставить("mode", Мсп_СхемаПараметров.НовыйСвойствоСхемыСEnum("string",
		"compile — только компиляция обёртки; execute — компиляция и вызов метода в транзакции",
		ДопустимыеРежимы));
	Свойства.Вставить("code", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Текст одной серверной функции или процедуры BSL"));
	Свойства.Вставить("arguments", Мсп_СхемаПараметров.НовыйСвойствоСхемы("object",
		"Аргументы вызова для режима execute; ключи должны совпадать с параметрами метода"));
	Свойства.Вставить("allow_changes", Мсп_СхемаПараметров.НовыйСвойствоСхемы("boolean",
		"Разрешить зафиксировать транзакцию после вызова (по умолчанию откат)"));
	Свойства.Вставить("confirm", Мсп_СхемаПараметров.НовыйСвойствоСхемы("boolean",
		"Подтверждение сохранения изменений; обязан быть true при allow_changes=true"));

	Требуемые = Новый Массив;
	Требуемые.Добавить("mode");
	Требуемые.Добавить("code");

	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Свойства, Требуемые);
КонецФункции

// Проверяет наличие непустого строкового аргумента.
//
// Параметры:
//  Аргументы - Структура - Аргументы вызова.
//  Имя - Строка - Имя аргумента.
//  Значение - Строка - Найденное значение аргумента.
//
// Возвращаемое значение:
//  Булево - Истина, если аргумент есть и непуст.
Функция СтроковыйАргумент(Аргументы, Имя, Значение)
	Если Не Аргументы.Свойство(Имя, Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Формирует ошибку отсутствия обязательного аргумента.
//
// Параметры:
//  Имя - Строка - Имя аргумента.
//
// Возвращаемое значение:
//  Структура - Ошибка инструмента.
Функция ОшибкаОтсутствующегоАргумента(Имя)
	Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS",
		СтрШаблон("missing required argument ""%1""", Имя));
КонецФункции

// Преобразует исключение серверного модуля в ошибку инструмента.
//
// Параметры:
//  ТекстОшибки - Строка - Описание исключения.
//
// Возвращаемое значение:
//  Структура - Ошибка инструмента.
Функция ОшибкаСервера(ТекстОшибки)
	Если СтрНайти(ТекстОшибки, "Object not found") > 0 Или СтрНайти(ТекстОшибки, "Form not found") > 0 Тогда
		Возврат Мсп_Сервер.ОшибкаИнструмента("NOT_FOUND", ТекстОшибки);
	КонецЕсли;
	Если СтрНайти(ТекстОшибки, "reading the event log requires") > 0 Тогда
		Возврат Мсп_Сервер.ОшибкаИнструмента("ACTION_DENIED", ТекстОшибки);
	КонецЕсли;
	Возврат Мсп_Сервер.ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
КонецФункции

#КонецОбласти
