// Обрабатывает вызов analyze_subsystems.
//
// Параметры:
//  Запрос - Структура - Запрос инструмента:
//   * Аргументы - Структура - Аргументы вызова: action, object, object_type, cross_branch_only.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры вызова.
//
// Возвращаемое значение:
//  Структура - Результат вызова инструмента.
Функция ОбработатьИнструментАнализаПодсистем(Запрос, ДополнительныеПараметры) Экспорт
	Попытка
		Аргументы = Запрос.Аргументы;

		Действие = "";
		Аргументы.Свойство("action", Действие);
		Действие = СокрЛП(Действие);
		Если Действие = "" Тогда
			Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS",
				"action is required (allowed: orphans, containing, intersections)");
		КонецЕсли;
		Если Действие <> "orphans" И Действие <> "containing" И Действие <> "intersections" Тогда
			Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS",
				СтрШаблон("unknown action: %1 (allowed: orphans, containing, intersections)", Действие));
		КонецЕсли;

		Объект = "";
		Аргументы.Свойство("object", Объект);
		Объект = СокрЛП(Объект);
		Если Действие = "containing" И Объект = "" Тогда
			Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS",
				"action=containing requires the object parameter (full or short metadata name)");
		КонецЕсли;

		ТипОбъекта = "";
		Аргументы.Свойство("object_type", ТипОбъекта);
		ТипОбъекта = СокрЛП(ТипОбъекта);

		ТолькоМежВеток = Ложь;
		Аргументы.Свойство("cross_branch_only", ТолькоМежВеток);

		Лес = Мсп_ИнструментыМетаданныхСервер.ДеревоПодсистем();

		Если Действие = "orphans" Тогда
			Результат = РезультатСирот(Лес);
		ИначеЕсли Действие = "containing" Тогда
			Результат = РезультатВхождения(Лес, Объект, ТипОбъекта);
		Иначе
			Результат = РезультатПересечений(Лес, ТолькоМежВеток);
		КонецЕсли;

		Возврат Мсп_Результаты.JSON(Результат);
	Исключение
		Возврат ОшибкаСервера(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

