#Область ПрограммныйИнтерфейс

// Регистрирует инструменты и промпты провайдера метаданных.
Процедура Зарегистрировать(ИсточникРегистрации) Экспорт
	ОписаниеДерева = ОписаниеИнструментаДереваМетаданных();
	СхемаДерева = СхемаИнструментаДереваМетаданных();
	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"get_metadata_tree",
		ОписаниеДерева,
		СхемаДерева,
		Новый ОписаниеОповещения("ОбработатьИнструментДереваМетаданных", Мсп_ИнструментыМетаданныхКлиент)),
		ИсточникРегистрации);

	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"get_object_structure",
		ОписаниеИнструментаСтруктурыОбъекта(),
		СхемаИнструментаСтруктурыОбъекта(),
		Новый ОписаниеОповещения("ОбработатьИнструментСтруктурыОбъекта", Мсп_ИнструментыМетаданныхКлиент)),
		ИсточникРегистрации);

	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"get_form_structure",
		ОписаниеИнструментаСтруктурыФормы(),
		СхемаИнструментаСтруктурыФормы(),
		Новый ОписаниеОповещения("ОбработатьИнструментСтруктурыФормы", Мсп_ИнструментыМетаданныхКлиент)),
		ИсточникРегистрации);

	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"analyze_subsystems",
		ОписаниеИнструментаАнализаПодсистем(),
		СхемаИнструментаАнализаПодсистем(),
		Новый ОписаниеОповещения("ОбработатьИнструментАнализаПодсистем", Мсп_ИнструментыМетаданныхКлиент)),
		ИсточникРегистрации);

	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"get_configuration_info",
		ОписаниеИнструментаИнформацииОКонфигурации(),
		СхемаИнструментаИнформацииОКонфигурации(),
		Новый ОписаниеОповещения("ОбработатьИнструментИнформацииОКонфигурации", Мсп_ИнструментыМетаданныхКлиент)),
		ИсточникРегистрации);

	ЗарегистрироватьПромптОбъясненияКонфигурации(ИсточникРегистрации);
	ЗарегистрироватьПромптОбъясненияОбъекта(ИсточникРегистрации);
	ЗарегистрироватьПромптНавигацииПоМетаданным(ИсточникРегистрации);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает вызов get_metadata_tree.
//
// Параметры:
//  Запрос - Структура - Запрос инструмента:
//   * Аргументы - Структура - Аргументы вызова, необязательный filter.
//  ДополнительныеПараметры - Произвольный - Дополнительные параметры вызова.
//
// Возвращаемое значение:
//  Структура - Результат вызова инструмента.
Функция ОбработатьИнструментДереваМетаданных(Запрос, ДополнительныеПараметры) Экспорт
	Попытка
		Дерево = Мсп_ИнструментыМетаданныхСервер.ДеревоМетаданных();

		Предупреждения = Новый Массив;
		Если Дерево.Свойство("warnings") Тогда
			Предупреждения = Дерево.warnings;
			Дерево.Удалить("warnings");
		КонецЕсли;

		Фильтр = "";
		Запрос.Аргументы.Свойство("filter", Фильтр);
		Фильтр = СокрЛП(Фильтр);

		Результат = Новый Структура;
		Если ЗначениеЗаполнено(Фильтр) Тогда
			Если Не Дерево.Свойство(Фильтр) Тогда
				Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS",
					СтрШаблон("unknown metadata category: %1", Фильтр));
			КонецЕсли;
			Результат.Вставить(Фильтр, ОтфильтроватьШум(Дерево[Фильтр]));
		Иначе
			Для Каждого КлючЗначение Из Дерево Цикл
				Результат.Вставить(КлючЗначение.Ключ, ОтфильтроватьШум(КлючЗначение.Значение));
			КонецЦикла;
		КонецЕсли;

		Если Предупреждения.Количество() > 0 Тогда
			Результат.Вставить("warnings", Предупреждения);
		КонецЕсли;

		Возврат Мсп_Результаты.JSON(Результат);
	Исключение
		Возврат ОшибкаСервера(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

