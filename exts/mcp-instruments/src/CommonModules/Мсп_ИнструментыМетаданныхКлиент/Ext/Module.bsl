// Строит результат действия orphans: объекты вне подсистем.
//
// Параметры:
//  Лес - Структура - Ответ ДеревоПодсистем().
//
// Возвращаемое значение:
//  Структура - {orphans, total, warnings?}.
Функция РезультатСирот(Лес)
	Принадлежность = ИндексПринадлежности(Лес.subsystems);

	ВиденныеИмена = Новый Соответствие;
	Сироты = Новый Массив;
	Для Каждого ПолноеИмя Из Лес.allObjects Цикл
		Если ЭтоШумноеИмя(ПолноеИмя) Или ВиденныеИмена.Получить(ПолноеИмя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Принадлежность.Получить(ПолноеИмя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВиденныеИмена.Вставить(ПолноеИмя, Истина);
		Сироты.Добавить(ПолноеИмя);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("orphans", ОтсортированныеСтроки(Сироты));
	Результат.Вставить("total", Сироты.Количество());
	ДобавитьПредупрежденияЛеса(Результат, Лес);
	Возврат Результат;
КонецФункции

// Строит результат действия containing: подсистемы, содержащие объект.
//
// Параметры:
//  Лес - Структура - Ответ ДеревоПодсистем().
//  Объект - Строка - Полное или короткое имя объекта.
//  ТипОбъекта - Строка - Необязательное уточнение вида метаданных.
//
// Возвращаемое значение:
//  Структура - {object, matched, total, warnings?}.
Функция РезультатВхождения(Лес, Объект, ТипОбъекта)
	Принадлежность = ИндексПринадлежности(Лес.subsystems);

	ЗапросНижнийРегистр = НРег(Объект);

	Совпадения = Новый Массив;
	Для Каждого КлючЗначение Из Принадлежность Цикл
		Если НРег(КлючЗначение.Ключ) = ЗапросНижнийРегистр Тогда
			Совпадения.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Если Совпадения.Количество() = 0 Тогда
		Для Каждого КлючЗначение Из Принадлежность Цикл
			Если НРег(КороткоеИмя(КлючЗначение.Ключ)) = ЗапросНижнийРегистр Тогда
				Совпадения.Добавить(КлючЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
		Если ТипОбъекта <> "" И Совпадения.Количество() > 1 Тогда
			Отфильтрованные = ОтфильтроватьПоТипу(Совпадения, ТипОбъекта);
			Если Отфильтрованные.Количество() > 0 Тогда
				Совпадения = Отфильтрованные;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Совпадения = ОтсортированныеСтроки(Совпадения);

	Совпавшие = Новый Массив;
	Всего = 0;
	Для Каждого ПолноеИмя Из Совпадения Цикл
		Ссылки = УникальныеСсылки(Принадлежность.Получить(ПолноеИмя));
		СортироватьСсылки(Ссылки);
		Всего = Всего + Ссылки.Количество();
		Совпавшие.Добавить(Новый Структура("object,subsystems", ПолноеИмя, Ссылки));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("object", Объект);
	Результат.Вставить("matched", Совпавшие);
	Результат.Вставить("total", Всего);
	ДобавитьПредупрежденияЛеса(Результат, Лес);
	Возврат Результат;
КонецФункции

// Строит результат действия intersections: объекты в нескольких подсистемах.
//
// Параметры:
//  Лес - Структура - Ответ ДеревоПодсистем().
//  ТолькоМежВеток - Булево - Оставить только пересечения между разными корнями.
//
// Возвращаемое значение:
//  Структура - {intersections, total, warnings?}.
Функция РезультатПересечений(Лес, ТолькоМежВеток)
	Принадлежность = ИндексПринадлежности(Лес.subsystems);

	Пересечения = Новый Массив;
	Для Каждого КлючЗначение Из Принадлежность Цикл
		ПолноеИмя = КлючЗначение.Ключ;
		Если ЭтоШумноеИмя(ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Ссылки = УникальныеСсылки(КлючЗначение.Значение);
		Если Ссылки.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Если ТолькоМежВеток И РазличныхКорней(Ссылки) < 2 Тогда
			Продолжить;
		КонецЕсли;
		СортироватьСсылки(Ссылки);
		Пересечения.Добавить(Новый Структура("object,subsystems", ПолноеИмя, Ссылки));
	КонецЦикла;

	СортироватьПоПолюОбъект(Пересечения);

	Результат = Новый Структура;
	Результат.Вставить("intersections", Пересечения);
	Результат.Вставить("total", Пересечения.Количество());
	ДобавитьПредупрежденияЛеса(Результат, Лес);
	Возврат Результат;
КонецФункции

// Строит индекс принадлежности: полное имя объекта -> массив ссылок на подсистемы.
//
// Параметры:
//  Узлы - Массив - Узлы дерева подсистем.
//
// Возвращаемое значение:
//  Соответствие - Ключ - полное имя объекта, значение - Массив из Структура("name,fullName,root").
Функция ИндексПринадлежности(Узлы)
	Принадлежность = Новый Соответствие;
	ОбойтиУзлыПодсистем(Узлы, "", Принадлежность);
	Возврат Принадлежность;
КонецФункции

// Обходит дерево подсистем, накапливая принадлежность объектов по прямому составу.
//
// Параметры:
//  Узлы - Массив - Узлы дерева подсистем.
//  Корень - Строка - Имя корневой подсистемы текущей ветки, "" для верхнего уровня.
//  Принадлежность - Соответствие - Накапливаемый индекс.
Процедура ОбойтиУзлыПодсистем(Узлы, Корень, Принадлежность)
	Для Каждого Узел Из Узлы Цикл
		ТекущийКорень = Корень;
		Если ПустаяСтрока(ТекущийКорень) Тогда
			ТекущийКорень = Узел.name;
		КонецЕсли;
		Для Каждого ПолноеИмя Из Узел.content Цикл
			Ссылки = Принадлежность.Получить(ПолноеИмя);
			Если Ссылки = Неопределено Тогда
				Ссылки = Новый Массив;
				Принадлежность.Вставить(ПолноеИмя, Ссылки);
			КонецЕсли;
			Ссылки.Добавить(Новый Структура("name,fullName,root", Узел.name, Узел.fullName, ТекущийКорень));
		КонецЦикла;
		ОбойтиУзлыПодсистем(Узел.subsystems, ТекущийКорень, Принадлежность);
	КонецЦикла;
КонецПроцедуры

