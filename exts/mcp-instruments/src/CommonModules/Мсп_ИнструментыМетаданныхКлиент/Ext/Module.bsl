		+ "РегистрыБухгалтерии->AccountingRegister, РегистрыРасчета->CalculationRegister, "
		+ "ПланыСчетов->ChartOfAccounts, ПланыВидовХарактеристик->ChartOfCharacteristicTypes, "
		+ "ПланыВидовРасчета->ChartOfCalculationTypes, ПланыОбмена->ExchangePlan, "
		+ "БизнесПроцессы->BusinessProcess, Задачи->Task.";

	Свойства = Новый Структура;
	Свойства.Вставить("object_type", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string", ОписаниеТипа));
	Свойства.Вставить("object_name",
		Мсп_СхемаПараметров.НовыйСвойствоСхемы("string", "Имя объекта метаданных"));

	Требуемые = Новый Массив;
	Требуемые.Добавить("object_type");
	Требуемые.Добавить("object_name");

	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Свойства, Требуемые);
КонецФункции

// Формирует схему параметров инструмента analyze_subsystems.
//
// Возвращаемое значение:
//  Структура - Схема параметров.
Функция СхемаИнструментаАнализаПодсистем()
	Свойства = Новый Структура;
	Свойства.Вставить("action", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Вид анализа: orphans (объекты вне подсистем), containing (подсистемы, содержащие объект), "
		+ "intersections (объекты в нескольких подсистемах)."));
	Свойства.Вставить("object", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Для action=containing: имя объекта. Полное (Документ.РеализацияТоваровУслуг) или короткое "
		+ "(РеализацияТоваровУслуг). При коротком неоднозначном имени возвращаются все совпадения."));
	Свойства.Вставить("object_type", Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
		"Необязательное уточнение для action=containing при неоднозначном коротком имени: префикс вида метаданных "
		+ "полного имени (Справочник, Документ, РегистрСведений и т.п.) или его английский эквивалент "
		+ "(Catalog, Document, InformationRegister)."));
	Свойства.Вставить("cross_branch_only", Мсп_СхемаПараметров.НовыйСвойствоСхемы("boolean",
		"Для action=intersections: если true, оставить только объекты, входящие в подсистемы из разных корневых "
		+ "веток дерева."));

	Требуемые = Новый Массив;
	Требуемые.Добавить("action");

	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Свойства, Требуемые);
КонецФункции

// Формирует схему параметров инструмента get_configuration_info.
//
// Возвращаемое значение:
//  Структура - Схема параметров без свойств.
Функция СхемаИнструментаИнформацииОКонфигурации()
	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Новый Структура, Неопределено);
КонецФункции

// Оставляет уникальные ссылки на подсистемы по паре имени и корня.
//
// Параметры:
//  Ссылки - Массив из Структура - Ссылки {name, fullName, root}.
//
// Возвращаемое значение:
//  Массив из Структура - Ссылки без дубликатов.
Функция УникальныеСсылки(Ссылки)
	Виденные = Новый Соответствие;
	Результат = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		Ключ = Ссылка.name + Символы.ПС + Ссылка.root;
		Если Виденные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Виденные.Вставить(Ключ, Истина);
		Результат.Добавить(Ссылка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Сортирует ссылки на подсистемы по имени, корню и полному имени.
//
// Параметры:
//  Ссылки - Массив из Структура - Ссылки {name, fullName, root}.
Процедура СортироватьСсылки(Ссылки)
	Для Индекс = 1 По Ссылки.Количество() - 1 Цикл
		Текущая = Ссылки[Индекс];
		Позиция = Индекс - 1;
		Пока Позиция >= 0 И СравнитьСсылки(Ссылки[Позиция], Текущая) > 0 Цикл
			Ссылки[Позиция + 1] = Ссылки[Позиция];
			Позиция = Позиция - 1;
		КонецЦикла;
		Ссылки[Позиция + 1] = Текущая;
	КонецЦикла;
КонецПроцедуры

// Сравнивает ссылки на подсистемы по имени, корню и полному имени.
//
// Параметры:
//  Первая - Структура - Первая ссылка.
//  Вторая - Структура - Вторая ссылка.
//
// Возвращаемое значение:
//  Число - -1, 0 или 1.
Функция СравнитьСсылки(Первая, Вторая)
	Результат = СравнитьСтроки(Первая.name, Вторая.name);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Результат = СравнитьСтроки(Первая.root, Вторая.root);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Возврат СравнитьСтроки(Первая.fullName, Вторая.fullName);
КонецФункции

// Сравнивает две строки лексикографически.
//
// Параметры:
//  Первая - Строка - Первая строка.
//  Вторая - Строка - Вторая строка.
//
// Возвращаемое значение:
//  Число - -1, 0 или 1.
Функция СравнитьСтроки(Первая, Вторая)
	Если Первая < Вторая Тогда
		Возврат -1;
	ИначеЕсли Первая > Вторая Тогда
		Возврат 1;
	КонецЕсли;
	Возврат 0;
КонецФункции

// Возвращает отсортированную копию массива строк.
//
// Параметры:
//  Значения - Массив из Строка - Исходные строки.
//
// Возвращаемое значение:
//  Массив из Строка - Отсортированные строки.
Функция ОтсортированныеСтроки(Значения)
	Список = Новый СписокЗначений;
	Для Каждого Значение Из Значения Цикл
		Список.Добавить(Значение);
	КонецЦикла;
	Список.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	Возврат Список.ВыгрузитьЗначения();
КонецФункции

// Сортирует элементы результата по полю object.
//
// Параметры:
//  Элементы - Массив из Структура - Элементы с полем object.
Процедура СортироватьПоПолюОбъект(Элементы)
	Для Индекс = 1 По Элементы.Количество() - 1 Цикл
		Текущий = Элементы[Индекс];
		Позиция = Индекс - 1;
		Пока Позиция >= 0 И Элементы[Позиция].object > Текущий.object Цикл
			Элементы[Позиция + 1] = Элементы[Позиция];
			Позиция = Позиция - 1;
		КонецЦикла;
		Элементы[Позиция + 1] = Текущий;
	КонецЦикла;
КонецПроцедуры

// Подсчитывает количество различных корневых подсистем в ссылках.
//
// Параметры:
//  Ссылки - Массив из Структура - Ссылки {name, fullName, root}.
//
// Возвращаемое значение:
//  Число - Количество различных корней.
Функция РазличныхКорней(Ссылки)
	Корни = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		Корни.Вставить(Ссылка.root, Истина);
	КонецЦикла;
	Возврат Корни.Количество();
КонецФункции

// Проверяет имя объекта по признаку шума присоединённых файлов.
//
// Параметры:
//  ПолноеИмя - Строка - Полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Булево - Истина, если имя шумовое.
Функция ЭтоШумноеИмя(ПолноеИмя)
	НижнийРегистр = НРег(ПолноеИмя);
	Возврат Прав(НижнийРегистр, 19) = "присоединенныефайлы"
		Или Прав(НижнийРегистр, 19) = "присоединённыефайлы";
КонецФункции

// Убирает шумовые имена из массива.
//
// Параметры:
//  Имена - Массив из Строка - Полные имена объектов.
//
// Возвращаемое значение:
//  Массив из Строка - Имена без шумовых.
Функция ОтфильтроватьШум(Имена)
	Результат = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Если Не ЭтоШумноеИмя(Имя) Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает короткое имя объекта без префикса вида.
//
// Параметры:
//  ПолноеИмя - Строка - Полное имя объекта метаданных.
//
// Возвращаемое значение:
//  Строка - Короткое имя.
Функция КороткоеИмя(ПолноеИмя)
	Позиция = СтрНайти(ПолноеИмя, ".", НаправлениеПоиска.СКонца);
	Если Позиция = 0 Тогда
		Возврат ПолноеИмя;
	КонецЕсли;
	Возврат Прав(ПолноеИмя, СтрДлина(ПолноеИмя) - Позиция);
КонецФункции

// Фильтрует совпадения по виду метаданных: русский или английский префикс.
//
// Параметры:
//  Совпадения - Массив из Строка - Полные имена объектов.
//  ТипОбъекта - Строка - Вид метаданных для фильтрации.
//
// Возвращаемое значение:
//  Массив из Строка - Отфильтрованные полные имена.
Функция ОтфильтроватьПоТипу(Совпадения, ТипОбъекта)
	ИскомыйВид = НРег(ТипОбъекта);
	РусскийВид = РусскийВидАнглийского(ИскомыйВид);
	Результат = Новый Массив;
	Для Каждого ПолноеИмя Из Совпадения Цикл
		Позиция = СтрНайти(ПолноеИмя, ".");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Префикс = НРег(Лев(ПолноеИмя, Позиция - 1));
		Если Префикс = ИскомыйВид Или (РусскийВид <> "" И Префикс = НРег(РусскийВид)) Тогда
			Результат.Добавить(ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает русский вид метаданных для английского имени вида.
//
// Параметры:
//  АнглийскийВид - Строка - Английское имя вида в нижнем регистре.
//
// Возвращаемое значение:
//  Строка - Русский вид или "".
Функция РусскийВидАнглийского(АнглийскийВид)
	Виды = Новый Соответствие;
	Виды.Вставить("catalog", "Справочник");
	Виды.Вставить("document", "Документ");
	Виды.Вставить("enum", "Перечисление");
	Виды.Вставить("report", "Отчет");
	Виды.Вставить("dataprocessor", "Обработка");
	Виды.Вставить("informationregister", "РегистрСведений");
	Виды.Вставить("accumulationregister", "РегистрНакопления");
	Виды.Вставить("accountingregister", "РегистрБухгалтерии");
	Виды.Вставить("calculationregister", "РегистрРасчета");
	Виды.Вставить("chartofaccounts", "ПланСчетов");
	Виды.Вставить("chartofcharacteristictypes", "ПланВидовХарактеристик");
	Виды.Вставить("chartofcalculationtypes", "ПланВидовРасчета");
	Виды.Вставить("exchangeplan", "ПланОбмена");
	Виды.Вставить("businessprocess", "БизнесПроцесс");
	Виды.Вставить("task", "Задача");

	Вид = Виды.Получить(АнглийскийВид);
	Если Вид = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Вид;
КонецФункции

// Добавляет в результат предупреждения леса подсистем, если они есть.
//
// Параметры:
//  Результат - Структура - Результат действия.
//  Лес - Структура - Ответ ДеревоПодсистем().
Процедура ДобавитьПредупрежденияЛеса(Результат, Лес)
	Предупреждения = Неопределено;
	Если Лес.Свойство("warnings", Предупреждения) Тогда
		Если Предупреждения <> Неопределено И Предупреждения.Количество() > 0 Тогда
			Результат.Вставить("warnings", Предупреждения);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Проверяет наличие непустого строкового аргумента.
//
// Параметры:
//  Аргументы - Структура - Аргументы вызова.
//  Имя - Строка - Имя аргумента.
//  Значение - Строка - Найденное значение аргумента.
//
// Возвращаемое значение:
//  Булево - Истина, если аргумент есть и непуст.
Функция СтроковыйАргумент(Аргументы, Имя, Значение)
	Если Не Аргументы.Свойство(Имя, Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Формирует ошибку отсутствия обязательного аргумента.
//
// Параметры:
//  Имя - Строка - Имя аргумента.
//
// Возвращаемое значение:
//  Структура - Ошибка инструмента.
Функция ОшибкаОтсутствующегоАргумента(Имя)
	Возврат Мсп_Сервер.ОшибкаИнструмента("INVALID_PARAMS",
		СтрШаблон("missing required argument ""%1""", Имя));
КонецФункции

// Преобразует исключение серверного модуля в ошибку инструмента.
//
// Параметры:
//  ТекстОшибки - Строка - Описание исключения.
//
// Возвращаемое значение:
//  Структура - Ошибка инструмента.
Функция ОшибкаСервера(ТекстОшибки)
	Если СтрНайти(ТекстОшибки, "Object not found") > 0 Или СтрНайти(ТекстОшибки, "Form not found") > 0 Тогда
		Возврат Мсп_Сервер.ОшибкаИнструмента("NOT_FOUND", ТекстОшибки);
	КонецЕсли;
	Если СтрНайти(ТекстОшибки, "reading the event log requires") > 0 Тогда
		Возврат Мсп_Сервер.ОшибкаИнструмента("ACTION_DENIED", ТекстОшибки);
	КонецЕсли;
	Возврат Мсп_Сервер.ОшибкаИнструмента("ACTION_FAILED", ТекстОшибки);
КонецФункции

#КонецОбласти
