#Область ПрограммныйИнтерфейс

// Проверяет и исполняет один метод BSL, переданный ИИ. Источник переноса - ПроверкаBSLPOST
// и хелперы MCP_* модуля MCPService mcp-1c.
//
// Контракт кода сохранён: mode = compile проверяет структуру объявления (начинается с
// Функция/Процедура, заканчивается Конец*, ровно одно объявление) и синтаксис тела через
// недостижимую ветку; mode = execute исполняет тело в транзакции. Выполнить() принимает
// операторы, а не объявления методов, поэтому вызов имитируется: строка объявления
// заменяется инициализацией служебных переменных и присваиваниями параметров, Возврат -
// присваиванием Мспи_ЗначениеВозврата со сбросом флага Мспи_ПродолжениеВыполнения, каждый
// листовой оператор после Возврат закрыт стражем флага. Координаты строк в диагностиках
// относятся к исходному коду.
//
// Параметры:
//  Режим - Строка - "compile" или "execute";
//  Код - Строка - текст ровно одного метода (Функция или Процедура);
//  Аргументы - Структура, Неопределено - значения параметров метода; ключи обязаны точно
//   (без учёта регистра) совпадать с именами параметров;
//  РазрешитьИзменения - Булево - разрешение фиксировать изменения данных;
//  Подтверждение - Булево - подтверждение фиксации; фиксация только при обоих флагах.
//
// Возвращаемое значение:
//  Структура - Поля 1:1 к ответу /validate-bsl mcp-1c:
//   * valid - Булево - успешность компиляции;
//   * executed - Булево - признак исполнения тела;
//   * rolled_back - Булево - признак отката транзакции;
//   * diagnostics - Массив из Структура - диагностики {stage, message, line, column};
//   * result - произвольное значение функции - только для исполненной Функции,
//     результат которой сериализуется без ошибки.
//
// Вызывает исключение:
//  При некорректном режиме, пустом коде, нарушении контракта одного метода,
//  несоответствии аргументов параметрам и при allow_changes без confirm - с текстами
//  исходных ошибок валидации mcp-1c.
Функция ПроверитьКод(Знач Режим, Знач Код, Знач Аргументы = Неопределено,
	Знач РазрешитьИзменения = Ложь, Знач Подтверждение = Ложь) Экспорт

	Режим = Строка(Режим);
	Если Режим <> "compile" И Режим <> "execute" Тогда
		ВызватьИсключение "mode must be ""compile"" or ""execute""";
	КонецЕсли;

	Код = Строка(Код);
	Если ПустаяСтрока(Код) Тогда
		ВызватьИсключение "code is required";
	КонецЕсли;

	// Ровно один метод в коде и никаких операторов вне его тела. Ключевые слова BSL
	// регистронезависимы, поэтому поиск идёт по нижнему регистру. Код обязан НАЧИНАТЬСЯ
	// с объявления и ЗАКАНЧИВАТЬСЯ концом метода: это единственный способ без полноценной
	// обёртки гарантировать, что Выполнить(Код) не исполнит посторонние операторы.
	Если НЕ КодНачинаетсяСОбъявленияМетода(Код) Тогда
		ВызватьИсключение "code must start with a Function or Procedure declaration";
	КонецЕсли;
	Если НЕ КодЗаканчиваетсяКонцомМетода(Код) Тогда
		ВызватьИсключение "code must end with КонецФункции or КонецПроцедуры and have no statements after it";
	КонецЕсли;

	КоличествоОбъявлений = ПодсчитатьКлючевоеСлово(Код, "Функция")
		+ ПодсчитатьКлючевоеСлово(Код, "Процедура");
	КоличествоКонцов = ПодсчитатьКлючевоеСлово(Код, "КонецФункции")
		+ ПодсчитатьКлючевоеСлово(Код, "КонецПроцедуры");
	Если КоличествоОбъявлений <> 1 ИЛИ КоличествоКонцов <> 1 Тогда
		ВызватьИсключение "code must contain exactly one Function or Procedure";
	КонецЕсли;

	РазрешитьИзменения = (РазрешитьИзменения = Истина);
	Подтверждение = (Подтверждение = Истина);
	Если РазрешитьИзменения И НЕ Подтверждение Тогда
		ВызватьИсключение "saving changes requires confirm=true";
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("executed", Ложь);
	Результат.Вставить("rolled_back", Ложь);
	Результат.Вставить("diagnostics", Новый Массив);

	Сигнатура = РазобратьСигнатуруМетода(Код);
	Если Сигнатура = Неопределено Тогда
		Результат.Вставить("valid", Ложь);
		Результат.diagnostics.Добавить(ДиагностикаОшибки("compile", "could not parse method signature"));
		Возврат Результат;
	КонецЕсли;

	// Проверка соответствия ключей аргументов параметрам метода.
	АргументыВызова = Новый Структура;
	Если Аргументы <> Неопределено Тогда
		Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
			ВызватьИсключение "arguments must be a JSON object";
		КонецЕсли;
		ОшибкаАргументов = ПроверитьСоответствиеАргументов(Сигнатура.Параметры, Аргументы);
		Если НЕ ПустаяСтрока(ОшибкаАргументов) Тогда
			ВызватьИсключение ОшибкаАргументов;
		КонецЕсли;
		АргументыВызова = Аргументы;
	Иначе
		Если Сигнатура.Параметры.Количество() > 0 Тогда
			ВызватьИсключение "method declares parameters but no arguments provided";
		КонецЕсли;
	КонецЕсли;

	// Построить операторный фрагмент, имитирующий тело метода.
	Построение = ПостроитьФрагментВызова(Код, Сигнатура, АргументыВызова);
	Если НЕ Построение.OK Тогда
		Результат.Вставить("valid", Ложь);
		Результат.diagnostics.Добавить(ДиагностикаОшибки("compile", Построение.Ошибка));
		Возврат Результат;
	КонецЕсли;

	// Предварительная синтаксическая проверка тела через недостижимую ветку: "Если Ложь
	// Тогда" полностью разбирается платформой, но не исполняется. Обёртка добавляет одну
	// строку сверху - корректируем координату на -1.
	ФрагментКомпиляции = "Если Ложь Тогда" + Символы.ПС + Построение.Фрагмент + Символы.ПС + "КонецЕсли;";
	Попытка
		Выполнить(ФрагментКомпиляции);
	Исключение
		Результат.Вставить("valid", Ложь);
		Диагностика = ДиагностикаОшибки("compile", ОписаниеОшибки());
		Если Диагностика.line > 0 Тогда
			Диагностика.line = Диагностика.line - 1;
		КонецЕсли;
		Результат.diagnostics.Добавить(Диагностика);
		Возврат Результат;
	КонецПопытки;
	Результат.Вставить("valid", Истина);

	Если Режим = "compile" Тогда
		Возврат Результат;
	КонецЕсли;

	// Режим execute: имитация вызова внутри транзакции. Переменные Мспи_ЗначениеВозврата
	// и Мспи_ПродолжениеВыполнения видны фрагменту тела.
	Мспи_ЗначениеВозврата = Неопределено;
	Мспи_ПродолжениеВыполнения = Истина;
	ТранзакцияОткрыта = Ложь;

	НачатьТранзакцию();
	ТранзакцияОткрыта = Истина;
	Попытка
		Выполнить(Построение.Фрагмент);
		Результат.executed = Истина;

		// Сериализация результата функции ДО фиксации: при ошибке сериализации изменения
		// обязаны быть отменены даже при двух флагах подтверждения.
		Если Сигнатура.Вид = "Функция" Тогда
			Сериализация = СериализоватьРезультат(Мспи_ЗначениеВозврата);
			Если НЕ Сериализация.OK Тогда
				ОтменитьТранзакцию();
				ТранзакцияОткрыта = Ложь;
				Результат.Вставить("rolled_back", Истина);
				Результат.diagnostics.Добавить(ДиагностикаОшибки("serialize", Сериализация.Ошибка));
				Возврат Результат;
			КонецЕсли;
			Если Сериализация.Значение <> Неопределено Тогда
				Результат.Вставить("result", Сериализация.Значение);
			КонецЕсли;
		КонецЕсли;

		Если РазрешитьИзменения И Подтверждение Тогда
			ЗафиксироватьТранзакцию();
			Результат.Вставить("rolled_back", Ложь);
		Иначе
			ОтменитьТранзакцию();
			Результат.Вставить("rolled_back", Истина);
		КонецЕсли;
		ТранзакцияОткрыта = Ложь;
	Исключение
		Если ТранзакцияОткрыта Тогда
			ОтменитьТранзакцию();
			ТранзакцияОткрыта = Ложь;
		КонецЕсли;
		Результат.Вставить("rolled_back", Истина);
		Результат.diagnostics.Добавить(ДиагностикаОшибки("execute", ОписаниеОшибки()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Извлекает из первой непустой строки кода вид метода (Функция или Процедура), его имя
// и список имён параметров. Значение по умолчанию и квалификатор Знач отбрасываются;
// параметры без имён пропускаются. Вид возвращается в канонической форме, имя и
// параметры - в исходном регистре.
//
// Возвращает структуру {Вид, Имя, Параметры, ИндексОбъявления, ИндексЗавершения}
// или Неопределено, если объявление не удалось разобрать.
Функция РазобратьСигнатуруМетода(Код)

	КоличествоСтрок = СтрЧислоСтрок(Код);
	Сигнатура = Неопределено;

	Для ИндексСтроки = 1 По КоличествоСтрок Цикл
		Стр = СокрЛП(СтрПолучитьСтроку(Код, ИндексСтроки));
		Если ПустаяСтрока(Стр) Тогда
			Продолжить;
		КонецЕсли;

		НижнийРегистр = НРег(Стр);
		Если СтрНачинаетсяС(НижнийРегистр, "функция ") Тогда
			ВидМетода = "Функция";
			ДлинаКлючевого = СтрДлина("функция ");
		ИначеЕсли СтрНачинаетсяС(НижнийРегистр, "процедура ") Тогда
			ВидМетода = "Процедура";
			ДлинаКлючевого = СтрДлина("процедура ");
		Иначе
			// Первая непустая строка обязана быть объявлением - выше это уже проверено,
			// но защищаемся.
			Возврат Неопределено;
		КонецЕсли;

		Остаток = СокрЛП(Сред(Стр, ДлинаКлючевого + 1));
		ПозицияСкобки = СтрНайти(Остаток, "(");
		Если ПозицияСкобки = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		ИмяМетода = СокрЛП(Лев(Остаток, ПозицияСкобки - 1));
		Если ПустаяСтрока(ИмяМетода) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ПозицияЗакрытия = СтрНайти(Остаток, ")", , ПозицияСкобки);
		Если ПозицияЗакрытия = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Внутри = Сред(Остаток, ПозицияСкобки + 1, ПозицияЗакрытия - ПозицияСкобки - 1);

		Параметры = Новый Массив;
		Если НЕ ПустаяСтрока(Внутри) Тогда
			Части = СтрРазделить(Внутри, ",");
			Для Каждого Часть Из Части Цикл
				Параметр = СокрЛП(Часть);
				// Отбрасываем квалификатор "Знач" (регистронезависимо).
				Если СтрНачинаетсяС(НРег(Параметр), "знач ") Тогда
					Параметр = СокрЛП(Сред(Параметр, СтрДлина("знач ") + 1));
				КонецЕсли;
				// Отбрасываем значение по умолчанию после "=".
				ПозицияРавно = СтрНайти(Параметр, "=");
				Если ПозицияРавно > 0 Тогда
					Параметр = СокрЛП(Лев(Параметр, ПозицияРавно - 1));
				КонецЕсли;
				// Отбрасываем хвостовой "Экспорт".
				Если НРег(Параметр) = "экспорт" Тогда
					Продолжить;
				КонецЕсли;
				Если НЕ ПустаяСтрока(Параметр) Тогда
					Параметры.Добавить(Параметр);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Сигнатура = Новый Структура;
		Сигнатура.Вставить("Вид", ВидМетода);
		Сигнатура.Вставить("Имя", ИмяМетода);
		Сигнатура.Вставить("Параметры", Параметры);
		Сигнатура.Вставить("ИндексОбъявления", ИндексСтроки);
		Прервать;
	КонецЦикла;

	Если Сигнатура = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Индекс завершения - последняя непустая строка (КонецФункции/КонецПроцедуры).
	ИндексЗавершения = 0;
	Для Счётчик = 1 По КоличествоСтрок Цикл
		ОбратныйИндекс = КоличествоСтрок - Счётчик + 1;
		СтрЗавершения = СокрЛП(СтрПолучитьСтроку(Код, ОбратныйИндекс));
		Если ПустаяСтрока(СтрЗавершения) Тогда
			Продолжить;
		КонецЕсли;
		ИндексЗавершения = ОбратныйИндекс;
		Прервать;
	КонецЦикла;

	Если ИндексЗавершения <= Сигнатура.ИндексОбъявления Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сигнатура.Вставить("ИндексЗавершения", ИндексЗавершения);

	Возврат Сигнатура;

КонецФункции

// Превращает текст метода в операторный фрагмент, пригодный для Выполнить(). Строка
// объявления заменяется инициализацией служебных переменных и присваиваниями параметров;
// строка завершения обнуляется; номера строк сохраняются, чтобы координаты ошибок
// относились к исходному коду.
//
// Возвращает структуру {OK, Фрагмент, Ошибка}.
Функция ПостроитьФрагментВызова(Код, Сигнатура, АргументыВызова)

	Ответ = Новый Структура;
	Ответ.Вставить("OK", Ложь);
	Ответ.Вставить("Фрагмент", "");
	Ответ.Вставить("Ошибка", "");

	КоличествоСтрок = СтрЧислоСтрок(Код);
	Если Сигнатура.ИндексОбъявления < 1 ИЛИ Сигнатура.ИндексЗавершения > КоличествоСтрок Тогда
		Ответ.Ошибка = "method boundary out of range";
		Возврат Ответ;
	КонецЕсли;

	// Заголовок на месте строки объявления: инициализация + присваивания параметров.
	// АргументыВызова - структура в контексте вызывающего метода, Выполнить() видит её
	// и резолвит имена параметров.
	Заголовок = "Мспи_ЗначениеВозврата = Неопределено; Мспи_ПродолжениеВыполнения = Истина;";
	Для Каждого ИмяПараметра Из Сигнатура.Параметры Цикл
		Заголовок = Заголовок + " " + ИмяПараметра + " = АргументыВызова." + ИмяПараметра + ";";
	КонецЦикла;

	Фрагмент = "";
	Для Индекс = 1 По КоличествоСтрок Цикл
		Если Индекс = Сигнатура.ИндексОбъявления Тогда
			СтрокаФрагмента = Заголовок;
		ИначеЕсли Индекс = Сигнатура.ИндексЗавершения Тогда
			СтрокаФрагмента = "";
		Иначе
			СтрокаФрагмента = ПреобразоватьСтрокуТела(СтрПолучитьСтроку(Код, Индекс));
		КонецЕсли;
		Если Индекс = 1 Тогда
			Фрагмент = СтрокаФрагмента;
		Иначе
			Фрагмент = Фрагмент + Символы.ПС + СтрокаФрагмента;
		КонецЕсли;
	КонецЦикла;

	Ответ.OK = Истина;
	Ответ.Фрагмент = Фрагмент;

	Возврат Ответ;

КонецФункции

// Переводит одну строку тела метода в операторный фрагмент: Возврат - в присваивание
// Мспи_ЗначениеВозврата + сброс флага Мспи_ПродолжениеВыполнения; структурные строки
// блоков (Если/Пока/Для/Попытка и их концы) остаются как есть; обычный оператор обёрнут
// в страж "Если Мспи_ПродолжениеВыполнения Тогда ... КонецЕсли;", чтобы после Возврат он
// не выполнялся. Строки с комментариями (//) пропускаются без обёртки, чтобы не разорвать
// синтаксис. Ограничение: каждый оператор тела на отдельной строке.
Функция ПреобразоватьСтрокуТела(Строка)

	Сжатая = СокрЛП(Строка);
	Если ПустаяСтрока(Сжатая) Тогда
		Возврат Строка;
	КонецЕсли;

	Если ЭтоОператорВозврат(Сжатая) Тогда
		Хвост = СокрЛП(Сред(Сжатая, СтрДлина("возврат") + 1));
		Выражение = "";
		Если НЕ ПустаяСтрока(Хвост) Тогда
			Если Прав(Хвост, 1) = ";" Тогда
				Выражение = СокрЛП(Лев(Хвост, СтрДлина(Хвост) - 1));
			Иначе
				Выражение = Хвост;
			КонецЕсли;
		КонецЕсли;
		Если ПустаяСтрока(Выражение) Тогда
			Возврат "Мспи_ПродолжениеВыполнения = Ложь;";
		КонецЕсли;
		Возврат "Мспи_ЗначениеВозврата = " + Выражение + "; Мспи_ПродолжениеВыполнения = Ложь;";
	КонецЕсли;

	Если ЭтоСтруктурнаяСтрокаБлоков(Сжатая) Тогда
		Возврат Строка;
	КонецЕсли;

	// Строки с комментарием оборачивать небезопасно (// съел бы КонецЕсли) - пропускаем
	// как есть. Побочных эффектов у чистого комментария нет.
	Если СтрНайти(Строка, "//") > 0 Тогда
		Возврат Строка;
	КонецЕсли;

	Возврат "Если Мспи_ПродолжениеВыполнения Тогда " + Строка + " КонецЕсли;";

КонецФункции

// Проверяет, что строка начинается с ключевого слова Возврат (регистронезависимо)
// как отдельной лексемы, а не с идентификатора вида "ВозвратЗначения".
Функция ЭтоОператорВозврат(Сжатая)

	Если НЕ СтрНачинаетсяС(НРег(Сжатая), "возврат") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(Сжатая) = СтрДлина("возврат") Тогда
		Возврат Истина;
	КонецЕсли;
	СимволПосле = Сред(Сжатая, СтрДлина("возврат") + 1, 1);

	Возврат СимволПосле = " " ИЛИ СимволПосле = ";";

КонецФункции

// Определяет строки - ключевые слова блоков BSL, которые нельзя оборачивать в страж
// (они задают структуру). Регистр не важен.
Функция ЭтоСтруктурнаяСтрокаБлоков(Сжатая)

	Нижний = НРег(Сжатая);
	Если СтрНачинаетсяС(Нижний, "если ") Тогда Возврат Истина; КонецЕсли;
	Если СтрНачинаетсяС(Нижний, "иначе") Тогда Возврат Истина; КонецЕсли;
	Если СтрНачинаетсяС(Нижний, "конецесли") Тогда Возврат Истина; КонецЕсли;
	Если СтрНачинаетсяС(Нижний, "пока ") Тогда Возврат Истина; КонецЕсли;
	Если СтрНачинаетсяС(Нижний, "для ") Тогда Возврат Истина; КонецЕсли;
	Если СтрНачинаетсяС(Нижний, "конеццикла") Тогда Возврат Истина; КонецЕсли;
	Если СтрНачинаетсяС(Нижний, "попытка") Тогда Возврат Истина; КонецЕсли;
	Если СтрНачинаетсяС(Нижний, "исключение") Тогда Возврат Истина; КонецЕсли;
	Если СтрНачинаетсяС(Нижний, "конецпопытки") Тогда Возврат Истина; КонецЕсли;
	Если СтрНачинаетсяС(Нижний, "прервать") Тогда Возврат Истина; КонецЕсли;
	Если СтрНачинаетсяС(Нижний, "продолжить") Тогда Возврат Истина; КонецЕсли;
	Возврат Ложь;

КонецФункции

// Возвращает пустую строку, если ключи аргументов точно совпадают (без учёта регистра)
// с именами параметров метода, иначе - читаемый текст ошибки. Сравнение без учёта
// регистра соответствует семантике обращения Структура.Свойство в BSL и доступу
// к свойствам структуры в сгенерированной обёртке вызова.
Функция ПроверитьСоответствиеАргументов(ПараметрыМетода, Аргументы)

	Для Каждого ИмяПараметра Из ПараметрыМетода Цикл
		Если НЕ Аргументы.Свойство(ИмяПараметра) Тогда
			Возврат "missing argument for parameter: " + ИмяПараметра;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Элемент Из Аргументы Цикл
		Найден = Ложь;
		Для Каждого ИмяПараметра Из ПараметрыМетода Цикл
			Если ВРег(Элемент.Ключ) = ВРег(ИмяПараметра) Тогда
				Найден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найден Тогда
			Возврат "unexpected argument: " + Элемент.Ключ;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Приводит значение функции к JSON-безопасному виду. Разрешены: Неопределено/NULL,
// Число, Строка, Булево, Дата (через XMLСтрока в ISO), Массив из разрешённых значений.
// Любой иной тип (Структура, Соответствие, Ссылка, ХранилищеЗначения и т.д.) - отказ
// с читаемой причиной.
//
// Возвращает структуру {OK, Значение, Ошибка}; при OK = Истина и Значение = Неопределено
// поле result в ответе опускается.
Функция СериализоватьРезультат(Значение)

	Ответ = Новый Структура;
	Ответ.Вставить("OK", Ложь);
	Ответ.Вставить("Значение", Неопределено);
	Ответ.Вставить("Ошибка", "");

	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Ответ.OK = Истина;
		Возврат Ответ;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Ответ.OK = Истина;
		Ответ.Значение = Значение;
		Возврат Ответ;
	КонецЕсли;

	Если ТипЗначения = Тип("Дата") Тогда
		Ответ.OK = Истина;
		Ответ.Значение = XMLСтрока(Значение);
		Возврат Ответ;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда
		СериализованныйМассив = Новый Массив;
		Для Индекс = 0 По Значение.Количество() - 1 Цикл
			СериализацияЭлемента = СериализоватьРезультат(Значение.Получить(Индекс));
			Если НЕ СериализацияЭлемента.OK Тогда
				Ответ.Ошибка = "array element " + Индекс + ": " + СериализацияЭлемента.Ошибка;
				Возврат Ответ;
			КонецЕсли;
			СериализованныйМассив.Добавить(СериализацияЭлемента.Значение);
		КонецЦикла;
		Ответ.OK = Истина;
		Ответ.Значение = СериализованныйМассив;
		Возврат Ответ;
	КонецЕсли;

	Ответ.Ошибка = "unsupported result type: " + Строка(ТипЗначения);

	Возврат Ответ;

КонецФункции

// Проверяет, что первая непустая строка кода начинается с ключевого слова Функция или
// Процедура (регистронезависимо, с учётом необязательных лидирующих пробелов). Это часть
// контракта одного метода: без этого Выполнить(Код) исполнил бы посторонние операторы.
Функция КодНачинаетсяСОбъявленияМетода(Код)

	КоличествоСтрок = СтрЧислоСтрок(Код);
	Для Индекс = 1 По КоличествоСтрок Цикл
		Стр = СокрЛП(СтрПолучитьСтроку(Код, Индекс));
		Если ПустаяСтрока(Стр) Тогда
			Продолжить;
		КонецЕсли;
		НизкийРегистр = НРег(Стр);
		Если СтрНачинаетсяС(НизкийРегистр, "функция ") ИЛИ СтрНачинаетсяС(НизкийРегистр, "процедура ") Тогда
			Возврат Истина;
		КонецЕсли;
		// Первая непустая строка должна быть объявлением; иначе это посторонний код.
		Возврат Ложь;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет, что последняя непустая строка кода - это КонецФункции или КонецПроцедуры
// (регистронезависимо). Вместе с началом-с-объявления это гарантирует отсутствие
// операторов после закрывающего ключевого слова.
Функция КодЗаканчиваетсяКонцомМетода(Код)

	КоличествоСтрок = СтрЧислоСтрок(Код);
	Для Счётчик = 1 По КоличествоСтрок Цикл
		Индекс = КоличествоСтрок - Счётчик + 1;
		Стр = СокрЛП(СтрПолучитьСтроку(Код, Индекс));
		Если ПустаяСтрока(Стр) Тогда
			Продолжить;
		КонецЕсли;
		НизкийРегистр = НРег(Стр);
		Возврат СтрНачинаетсяС(НизкийРегистр, "конецфункции") ИЛИ СтрНачинаетсяС(НизкийРегистр, "конецпроцедуры");
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает количество вхождений ключевого слова BSL (Функция, Процедура,
// КонецФункции, КонецПроцедуры) как отдельных лексем в тексте модуля. Ключевые слова BSL
// регистронезависимы, поэтому и текст, и слово приводятся к нижнему регистру. Учитываются
// только слова, окружённые пробелами или границами строки, чтобы не задеть идентификаторы
// вида "МояФункция".
Функция ПодсчитатьКлючевоеСлово(Текст, Слово)

	КоличествоСтрок = СтрЧислоСтрок(Текст);
	Счётчик = 0;
	ИскомоеСлово = " " + НРег(Слово) + " ";

	Для ИндексСтроки = 1 По КоличествоСтрок Цикл
		Стр = СтрЗаменить(СтрПолучитьСтроку(Текст, ИндексСтроки), Символы.Таб, " ");
		// Окружаем пробелами, чтобы искать слова целиком без регулярных выражений.
		НормализованнаяСтр = " " + НРег(СокрЛП(Стр)) + " ";
		// СтрНайти требует НачальнаяПозиция <= ДлинаСтроки (иначе "Неверное значение
		// параметра"). После нахождения слова Позиция переходит за его конец, что может
		// выйти за границу строки на следующей итерации; цикл ограничен длиной строки.
		ДлинаСтроки = СтрДлина(НормализованнаяСтр);
		Позиция = 1;
		Пока Позиция > 0 И Позиция <= ДлинаСтроки Цикл
			Позиция = СтрНайти(
				НормализованнаяСтр,
				ИскомоеСлово,
				НаправлениеПоиска.СНачала,
				Позиция);
			Если Позиция > 0 Тогда
				Счётчик = Счётчик + 1;
				Позиция = Позиция + СтрДлина(ИскомоеСлово);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Счётчик;

КонецФункции

// Разбирает текст ОписаниеОшибки() платформы и возвращает структуру с полями stage,
// message, line, column. Текст имеет вложенный формат:
// {<ВнешнийМодуль>(L1)}: ... {<ВнутреннийМодуль>(L2,C2)}: сообщение. Потребителю нужна
// самая глубокая (последняя) координата и текст после неё - это координата внутри
// переданного кода, а не строка модуля расширения.
Функция ДиагностикаОшибки(Стадия, ТекстОшибки)

	Диагностика = Новый Структура;
	Диагностика.Вставить("stage", Стадия);
	Диагностика.Вставить("line", 0);
	Диагностика.Вставить("column", 0);
	Диагностика.Вставить("message", ТекстОшибки);

	// Последняя фигурная скобка открывает самый глубокий блок с координатой.
	Позиция = 1;
	ПозицияФигурнойСкобки = 0;
	Пока Истина Цикл
		Найденная = СтрНайти(ТекстОшибки, "{", , Позиция);
		Если Найденная = 0 Тогда
			Прервать;
		КонецЕсли;
		ПозицияФигурнойСкобки = Найденная;
		Позиция = Найденная + 1;
	КонецЦикла;

	Если ПозицияФигурнойСкобки = 0 Тогда
		Возврат Диагностика;
	КонецЕсли;

	ПозицияСкобки = СтрНайти(ТекстОшибки, "(", , ПозицияФигурнойСкобки);
	Если ПозицияСкобки = 0 Тогда
		Возврат Диагностика;
	КонецЕсли;
	ПозицияЗакрытия = СтрНайти(ТекстОшибки, ")", , ПозицияСкобки);
	Если ПозицияЗакрытия = 0 Тогда
		Возврат Диагностика;
	КонецЕсли;

	Внутри = Сред(ТекстОшибки, ПозицияСкобки + 1, ПозицияЗакрытия - ПозицияСкобки - 1);
	Части = СтрРазделить(Внутри, ",");
	Если Части.Количество() >= 1 Тогда
		Попытка
			Диагностика.line = Число(СокрЛП(Части[0]));
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если Части.Количество() >= 2 Тогда
		Попытка
			Диагностика.column = Число(СокрЛП(Части[1]));
		Исключение
		КонецПопытки;
	КонецЕсли;

	ПозицияЗакрывающейФигуры = СтрНайти(ТекстОшибки, "}", , ПозицияЗакрытия);
	Если ПозицияЗакрывающейФигуры > 0 Тогда
		Сообщение = СокрЛП(Сред(ТекстОшибки, ПозицияЗакрывающейФигуры + 1));
		Если СтрНачинаетсяС(Сообщение, ":") Тогда
			Сообщение = СокрЛП(Сред(Сообщение, 2));
		КонецЕсли;
		Диагностика.message = Сообщение;
	КонецЕсли;

	Возврат Диагностика;

КонецФункции

#КонецОбласти
