#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Исполняет фрагмент во вновь созданном сеансе.
//
// Параметры:
//  Код - Строка - Фрагмент BSL.
//
// Возвращаемое значение:
//  Структура - Ответ REPL.
Функция ИсполнитьВНовомСеансе(Код)
	Адрес = Мсп_ИнструментыREPLКлиент.СоздатьСеанс();
	Возврат Мсп_ИнструментыREPLКлиент.Исполнить(Адрес, Код);
КонецФункции

// Извлекает value из ответа REPL.
//
// Возвращаемое значение:
//  Структура - Сериализованное значение.
Функция ЗначениеОтвета(Ответ)
	Значение = Неопределено;
	Ответ.Свойство("value", Значение);
	Возврат Значение;
КонецФункции

// Извлекает error из ответа REPL.
//
// Возвращаемое значение:
//  Структура - Ошибка исполнения.
Функция ОшибкаОтвета(Ответ)
	Ошибка = Неопределено;
	Ответ.Свойство("error", Ошибка);
	Возврат Ошибка;
КонецФункции

// Формирует фрагмент подсчёта элементов справочника Номенклатура по точному наименованию.
//
// Параметры:
//  Наименование - Строка - Наименование элемента.
//
// Возвращаемое значение:
//  Строка - Фрагмент BSL.
Функция ФрагментПодсчётаТоваров(Наименование)
	Части = Новый Массив;
	Части.Добавить("Запрос = Новый Запрос(""ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество "
		+ "ИЗ Справочник.Номенклатура ГДЕ Наименование = &Наименование"");");
	Части.Добавить("Запрос.УстановитьПараметр(""Наименование"", """ + Наименование + """);");
	Части.Добавить("Выборка = Запрос.Выполнить().Выбрать();");
	Части.Добавить("Выборка.Следующий();");
	Части.Добавить("Результат = Выборка.Количество");
	Возврат СтрСоединить(Части, Символы.ПС);
КонецФункции

// Проверяет наличие справочника Номенклатура: во фрагменте видны менеджеры объектов
// всей базы, а Метаданные относятся к расширению mcp_instruments.
//
// Возвращаемое значение:
//  Булево - Есть ли Справочник.Номенклатура.
Функция ЕстьСправочникНоменклатура()
	Ответ = ИсполнитьВНовомСеансе(
		"Попытка
		|	Менеджер = Справочники.Номенклатура
		|Исключение
		|	Менеджер = Неопределено
		|КонецПопытки;
		|Результат = Менеджер <> Неопределено");
	Значение = ЗначениеОтвета(Ответ);
	Есть = Ложь;
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Есть = Значение.json = Истина;
	КонецЕсли;
	Возврат Есть;
КонецФункции

#КонецОбласти
