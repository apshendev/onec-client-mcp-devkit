#Область ПрограммныйИнтерфейс

// Регистрирует сценарии тестового модуля.
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты.ДобавитьТест("ВыражениеВозвращаетсяЗначением")
		.ДобавитьТест("ОператорыБезРезультатаНеВозвращаютЗначение")
		.ДобавитьТест("ОператорыСРезультатомВозвращаютЗначение")
		.ДобавитьТест("ЗаписьСправочникаОткатывается")
		.ДобавитьТест("СостояниеПереживаетГраницуВызовов")
		.ДобавитьТест("УправлениеТранзакциямиВырезается")
		.ДобавитьТест("МодульКомпилируетсяБезВызова")
		.ДобавитьТест("СинтаксическаяОшибкаМодуляСодержитСтроку")
		.ДобавитьТест("МетодМодуляВызываетсяСАргументами")
		.ДобавитьТест("НесуществующийСеансДАётОшибку")
		.ДобавитьТест("ПустойКодДАётИнвалидныйАргумент");
КонецПроцедуры

// Проверяет, что выражение классифицируется в expression и возвращает значение.
Процедура ВыражениеВозвращаетсяЗначением() Экспорт
	Ответ = ИсполнитьВНовомСеансе("2 + 2");

	ЮТест.ОжидаетЧто(Ответ).Свойство("status", "ok");
	ЮТест.ОжидаетЧто(Ответ).Свойство("mode", "expression");

	Значение = ЗначениеОтвета(Ответ);
	ЮТест.ОжидаетЧто(Значение).Свойство("has_value", Истина);
	ЮТест.ОжидаетЧто(Значение).Свойство("type", "Число");
	ЮТест.ОжидаетЧто(Значение).Свойство("json", 4);
КонецПроцедуры

// Проверяет, что операторы без переменной Результат не возвращают значение.
Процедура ОператорыБезРезультатаНеВозвращаютЗначение() Экспорт
	Ответ = ИсполнитьВНовомСеансе("А = 1");

	ЮТест.ОжидаетЧто(Ответ).Свойство("status", "ok");
	ЮТест.ОжидаетЧто(Ответ).Свойство("mode", "statements");

	Значение = ЗначениеОтвета(Ответ);
	ЮТест.ОжидаетЧто(Значение).Свойство("has_value", Ложь);
КонецПроцедуры

// Проверяет, что переменная Результат возвращается значением операторного фрагмента.
Процедура ОператорыСРезультатомВозвращаютЗначение() Экспорт
	Ответ = ИсполнитьВНовомСеансе("Результат = 6 * 7");

	ЮТест.ОжидаетЧто(Ответ).Свойство("mode", "statements");

	Значение = ЗначениеОтвета(Ответ);
	ЮТест.ОжидаетЧто(Значение).Свойство("has_value", Истина);
	ЮТест.ОжидаетЧто(Значение).Свойство("json", 42);
КонецПроцедуры

// Проверяет, что записанный фрагментом элемент справочника откатывается,
// а ссылка на него возвращается значением.
Процедура ЗаписьСправочникаОткатывается() Экспорт
	Если НЕ ЕстьСправочникНоменклатура() Тогда
		ЮТест.Пропустить("в базе нет Справочник.Номенклатура");
	КонецЕсли;

	Адрес = Мсп_ИнструментыREPLКлиент.СоздатьСеанс();

	ФрагментЗаписи =
		"Т = Справочники.Номенклатура.СоздатьЭлемент();
		|Т.Наименование = ""Мспи_REPL_ТестОтката"";
		|Т.Записать();
		|Результат = Т.Ссылка";
	Ответ = Мсп_ИнструментыREPLКлиент.Исполнить(Адрес, ФрагментЗаписи);

	ЮТест.ОжидаетЧто(Ответ).Свойство("status", "ok");
	ЮТест.ОжидаетЧто(Ответ).Свойство("rolled_back", Истина);

	Значение = ЗначениеОтвета(Ответ);
	ЮТест.ОжидаетЧто(Значение).Свойство("has_value", Истина);
	ЮТест.ОжидаетЧто(Значение).Свойство("type", "СправочникСсылка.Номенклатура");

	ОтветПодсчёта = Мсп_ИнструментыREPLКлиент.Исполнить(Адрес, ФрагментПодсчётаТоваров("Мспи_REPL_ТестОтката"));
	ЮТест.ОжидаетЧто(ОтветПодсчёта).Свойство("status", "ok");
	ЮТест.ОжидаетЧто(ЗначениеОтвета(ОтветПодсчёта)).Свойство("json", 0);
КонецПроцедуры

// Проверяет, что Состояние переживает границу вызовов сеанса.
Процедура СостояниеПереживаетГраницуВызовов() Экспорт
	Адрес = Мсп_ИнструментыREPLКлиент.СоздатьСеанс();

	ОтветЗаписи = Мсп_ИнструментыREPLКлиент.Исполнить(Адрес,
		"Состояние.Вставить(""Счётчик"", 42);
		|Результат = 1");
	ЮТест.ОжидаетЧто(ОтветЗаписи).Свойство("status", "ok");

	ОтветЧтения = Мсп_ИнструментыREPLКлиент.Исполнить(Адрес,
		"Результат = Состояние[""Счётчик""]");
	ЮТест.ОжидаетЧто(ОтветЧтения).Свойство("status", "ok");
	ЮТест.ОжидаетЧто(ЗначениеОтвета(ОтветЧтения)).Свойство("json", 42);
КонецПроцедуры

// Проверяет, что вызовы управления транзакциями вырезаются из фрагмента.
Процедура УправлениеТранзакциямиВырезается() Экспорт
	Если НЕ ЕстьСправочникНоменклатура() Тогда
		ЮТест.Пропустить("в базе нет Справочник.Номенклатура");
	КонецЕсли;

	Адрес = Мсп_ИнструментыREPLКлиент.СоздатьСеанс();

	Фрагмент =
		"НачатьТранзакцию();
		|Т = Справочники.Номенклатура.СоздатьЭлемент();
		|Т.Наименование = ""Мспи_REPL_ТестВырезания"";
		|Т.Записать();
		|ЗафиксироватьТранзакцию();";
	Ответ = Мсп_ИнструментыREPLКлиент.Исполнить(Адрес, Фрагмент);

	ЮТест.ОжидаетЧто(Ответ).Свойство("status", "ok");
	ЮТест.ОжидаетЧто(Ответ).Свойство("rolled_back", Истина);

	ОтветПодсчёта = Мсп_ИнструментыREPLКлиент.Исполнить(Адрес, ФрагментПодсчётаТоваров("Мспи_REPL_ТестВырезания"));
	ЮТест.ОжидаетЧто(ЗначениеОтвета(ОтветПодсчёта)).Свойство("json", 0);
КонецПроцедуры

// Проверяет компиляцию module-фрагмента без вызова метода.
Процедура МодульКомпилируетсяБезВызова() Экспорт
	Ответ = ИсполнитьВНовомСеансе(
		"Функция Привет() Экспорт
		|	Возврат 1
		|КонецФункции");

	ЮТест.ОжидаетЧто(Ответ).Свойство("status", "ok");
	ЮТест.ОжидаетЧто(Ответ).Свойство("mode", "module");
	ЮТест.ОжидаетЧто(Ответ).Свойство("rolled_back", Истина);
	ЮТест.ОжидаетЧто(ЗначениеОтвета(Ответ)).Свойство("has_value", Ложь);
КонецПроцедуры

// Проверяет, что синтаксическая ошибка module-фрагмента даёт compile_error с номером строки.
Процедура СинтаксическаяОшибкаМодуляСодержитСтроку() Экспорт
	Ответ = ИсполнитьВНовомСеансе(
		"Функция Привет() Экспорт
		|	Возврат 1 +
		|КонецФункции");

	ЮТест.ОжидаетЧто(Ответ).Свойство("status", "error");
	ЮТест.ОжидаетЧто(Ответ).Свойство("mode", "module");

	Ошибка = ОшибкаОтвета(Ответ);
	ЮТест.ОжидаетЧто(Ошибка).Свойство("kind", "compile_error");

	НомерСтроки = 0;
	Ошибка.Свойство("line", НомерСтроки);
	ЮТест.ОжидаетЧто(НомерСтроки > 0).ЭтоИстина();
КонецПроцедуры

// Проверяет вызов экспортной функции module-фрагмента с аргументами по имени.
Процедура МетодМодуляВызываетсяСАргументами() Экспорт
	Адрес = Мсп_ИнструментыREPLКлиент.СоздатьСеанс();
	Аргументы = Новый Структура("А, Б", 2, 3);

	Ответ = Мсп_ИнструментыREPLКлиент.Исполнить(Адрес,
		"Функция Сумма(А, Б) Экспорт
		|	Возврат А + Б
		|КонецФункции", "Сумма", Аргументы);

	ЮТест.ОжидаетЧто(Ответ).Свойство("status", "ok");
	ЮТест.ОжидаетЧто(Ответ).Свойство("mode", "module");

	Значение = ЗначениеОтвета(Ответ);
	ЮТест.ОжидаетЧто(Значение).Свойство("has_value", Истина);
	ЮТест.ОжидаетЧто(Значение).Свойство("json", 5);
КонецПроцедуры

